# Copier ce fichier en .env pour travailler en local.
# Sans PUBLIC_SANITY_PROJECT_ID, le site s'affiche avec du contenu d'exemple.

# Projet Sanity de Caroline (sanity.io/manage > projet > Project ID)
PUBLIC_SANITY_PROJECT_ID=
PUBLIC_SANITY_DATASET=production

# Jeton en lecture (sanity.io/manage > API > Tokens > Viewer), sert uniquement à l'aperçu des brouillons
SANITY_API_READ_TOKEN=
# Mot de passe de l'aperçu, à choisir (même valeur que SANITY_STUDIO_PREVIEW_SECRET dans studio/.env)
SANITY_PREVIEW_SECRET=

# Google Tag Manager de Caroline (GTM-XXXXXXX) : prioritaire. Le conteneur doit contenir la balise Google Analytics 4.
PUBLIC_GTM_ID=

# Ou, sans Tag Manager : identifiant de mesure Google Analytics (G-XXXXXXX).
# Les deux vides = pas de mesure d'audience ni de bandeau cookies.
PUBLIC_GA_ID=

# true tant que le site est sur l'adresse provisoire : Google ne l'indexe pas.
PUBLIC_NOINDEX=true
