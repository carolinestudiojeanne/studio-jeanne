# Copier ce fichier en .env et remplir avec les valeurs du projet Sanity de Caroline.
SANITY_STUDIO_PROJECT_ID=
SANITY_STUDIO_DATASET=production
# Adresse du site (provisoire Netlify, puis https://www.studio-jeanne.com)
SANITY_STUDIO_SITE_URL=http://localhost:4321
# Même valeur que SANITY_PREVIEW_SECRET côté site (bouton « Voir la page »)
SANITY_STUDIO_PREVIEW_SECRET=
