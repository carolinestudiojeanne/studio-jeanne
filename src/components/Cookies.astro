---
/**
 * Bandeau cookies conforme CNIL : « Accepter » et « Refuser » au même niveau.
 * Google Analytics (propriété existante de Caroline) n'est chargé qu'après accord.
 * Le choix est gardé 6 mois ; « Gérer les cookies » en pied de page rouvre le bandeau.
 */
interface Props {
  gaId: string
}
const {gaId} = Astro.props
---

<div class="cookies" role="dialog" aria-live="polite" aria-label="Cookies" hidden data-ga={gaId}>
  <p>
    J’utilise des cookies de mesure d’audience pour savoir quelles pages vous sont utiles. Rien n’est déposé sans votre accord.
    <a href="/politique-de-confidentialite">En savoir plus</a>
  </p>
  <div class="cookies__boutons">
    <button type="button" class="bouton bouton--contour" data-choix="refuse">Refuser</button>
    <button type="button" class="bouton bouton--contour" data-choix="accepte">Accepter</button>
  </div>
</div>

<script>
  const CLE = 'sj-consentement'
  const DUREE = 1000 * 60 * 60 * 24 * 182
  const bandeau = document.querySelector<HTMLElement>('.cookies')
  const gaId = bandeau?.dataset.ga

  function lireChoix(): string | null {
    try {
      const brut = localStorage.getItem(CLE)
      if (!brut) return null
      const {choix, date} = JSON.parse(brut)
      return Date.now() - date < DUREE ? choix : null
    } catch {
      return null
    }
  }

  function chargerAnalytics() {
    if (!gaId || (window as any).__gaCharge) return
    ;(window as any).__gaCharge = true
    const s = document.createElement('script')
    s.async = true
    s.src = `https://www.googletagmanager.com/gtag/js?id=${gaId}`
    document.head.appendChild(s)
    const w = window as any
    w.dataLayer = w.dataLayer || []
    w.gtag = function () {
      w.dataLayer.push(arguments)
    }
    w.gtag('js', new Date())
    w.gtag('config', gaId, {anonymize_ip: true})
  }

  function enregistrer(choix: string) {
    try {
      localStorage.setItem(CLE, JSON.stringify({choix, date: Date.now()}))
    } catch {}
    if (bandeau) bandeau.hidden = true
    if (choix === 'accepte') chargerAnalytics()
    else if ((window as any).__gaCharge) location.reload()
  }

  const choix = lireChoix()
  if (choix === 'accepte') chargerAnalytics()
  else if (!choix && bandeau) bandeau.hidden = false

  bandeau?.querySelectorAll<HTMLButtonElement>('[data-choix]').forEach((b) =>
    b.addEventListener('click', () => enregistrer(b.dataset.choix!)),
  )
  document.querySelectorAll('[data-gerer-cookies]').forEach((b) =>
    b.addEventListener('click', () => {
      if (bandeau) bandeau.hidden = false
    }),
  )
</script>

<style>
  .cookies {
    position: fixed;
    inset: auto 1rem 1rem;
    z-index: 60;
    max-width: 34rem;
    margin-left: auto;
    background: var(--creme);
    border: 1px solid color-mix(in srgb, var(--ardoise) 20%, transparent);
    padding: 1.5rem;
    font-size: var(--t-s);
    box-shadow: 0 10px 40px rgb(0 0 0 / 0.08);
  }
  .cookies[hidden] {
    display: none;
  }
  .cookies__boutons {
    display: flex;
    gap: 0.75rem;
    margin-top: 1rem;
  }
  .cookies__boutons .bouton {
    flex: 1;
    justify-content: center;
    padding-inline: 1rem;
  }
</style>
