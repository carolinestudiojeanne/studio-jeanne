---
/**
 * Bandeau cookies conforme CNIL : « Accepter » et « Refuser » au même niveau.
 * Google Tag Manager (conteneur de Caroline, GTM-…) ou, à défaut, Google Analytics (G-…) n'est chargé qu'après accord :
 * rien n'est déposé avant. Refuser ensuite (« Gérer les cookies ») efface les cookies de mesure et recharge la page.
 * Le choix est gardé 6 mois ; « Gérer les cookies » en pied de page rouvre le bandeau.
 */
interface Props {
  gaId?: string
  gtmId?: string
}
const {gaId = '', gtmId = ''} = Astro.props
---

<div class="cookies" role="dialog" aria-live="polite" aria-label="Cookies" hidden data-ga={gaId} data-gtm={gtmId}>
  <p>
    Des cookies de mesure d’audience, uniquement avec votre accord.{' '}
    <a href="/politique-de-confidentialite">En savoir plus</a>
  </p>
  <div class="cookies__boutons">
    <button type="button" data-choix="refuse">Refuser</button>
    <button type="button" data-choix="accepte">Accepter</button>
  </div>
</div>

<script>
  const CLE = 'sj-consentement'
  const DUREE = 1000 * 60 * 60 * 24 * 182
  const bandeau = document.querySelector<HTMLElement>('.cookies')
  const gaId = bandeau?.dataset.ga
  const gtmId = bandeau?.dataset.gtm

  function lireChoix(): string | null {
    try {
      const brut = localStorage.getItem(CLE)
      if (!brut) return null
      const {choix, date} = JSON.parse(brut)
      return Date.now() - date < DUREE ? choix : null
    } catch {
      return null
    }
  }

  function chargerAnalytics() {
    const w = window as any
    if ((!gaId && !gtmId) || w.__gaCharge) return
    w.__gaCharge = true
    w.dataLayer = w.dataLayer || []
    const s = document.createElement('script')
    s.async = true
    if (gtmId) {
      // Google Tag Manager : le conteneur de Caroline contient la balise Google Analytics.
      w.dataLayer.push({'gtm.start': Date.now(), event: 'gtm.js'})
      s.src = `https://www.googletagmanager.com/gtm.js?id=${gtmId}`
      document.head.appendChild(s)
      return
    }
    s.src = `https://www.googletagmanager.com/gtag/js?id=${gaId}`
    document.head.appendChild(s)
    w.gtag = function () {
      w.dataLayer.push(arguments)
    }
    w.gtag('js', new Date())
    w.gtag('config', gaId, {anonymize_ip: true})
  }

  // Retrait du consentement : efface les cookies Google Analytics (_ga, _ga_…, _gid) sur le domaine du site.
  function effacerCookiesMesure() {
    const domaines = ['', location.hostname, '.' + location.hostname.replace(/^www\./, '')]
    document.cookie.split(';').forEach((c) => {
      const nom = c.split('=')[0].trim()
      if (!/^(_ga|_gid|_gat)/.test(nom)) return
      domaines.forEach((d) => {
        document.cookie = `${nom}=; expires=Thu, 01 Jan 1970 00:00:00 GMT; path=/${d ? `; domain=${d}` : ''}`
      })
    })
  }

  function enregistrer(choix: string) {
    try {
      localStorage.setItem(CLE, JSON.stringify({choix, date: Date.now()}))
    } catch {}
    if (bandeau) bandeau.hidden = true
    if (choix === 'accepte') chargerAnalytics()
    else {
      effacerCookiesMesure()
      if ((window as any).__gaCharge) location.reload()
    }
  }

  const choix = lireChoix()
  if (choix === 'accepte') chargerAnalytics()
  else if (!choix && bandeau) bandeau.hidden = false

  bandeau?.querySelectorAll<HTMLButtonElement>('[data-choix]').forEach((b) =>
    b.addEventListener('click', () => enregistrer(b.dataset.choix!)),
  )
  document.querySelectorAll('[data-gerer-cookies]').forEach((b) =>
    b.addEventListener('click', () => {
      if (bandeau) bandeau.hidden = false
    }),
  )
</script>

<style>
  /* Bandeau minimaliste : petite carte crème, filet fin, deux choix en capitales espacées
     de même poids (exigence CNIL : refuser aussi simple qu’accepter). */
  .cookies {
    position: fixed;
    left: 1rem;
    bottom: 1rem;
    z-index: 60;
    max-width: min(22rem, calc(100vw - 2rem));
    background: var(--creme);
    border: 1px solid color-mix(in srgb, var(--ardoise) 18%, transparent);
    padding: 1rem 1.25rem;
    font-size: var(--t-xs);
    letter-spacing: 0.04em;
    line-height: 1.6;
  }
  .cookies[hidden] {
    display: none;
  }
  .cookies p {
    margin: 0;
  }
  .cookies p a {
    white-space: nowrap;
  }
  .cookies__boutons {
    display: flex;
    gap: 1.75rem;
    margin-top: 0.75rem;
  }
  .cookies__boutons button {
    background: none;
    border: 0;
    padding: 0.2rem 0;
    color: var(--ardoise);
    font: inherit;
    text-transform: uppercase;
    letter-spacing: 0.18em;
    border-bottom: 1px solid transparent;
    cursor: pointer;
    transition: border-color 0.25s;
  }
  .cookies__boutons button:hover {
    border-bottom-color: var(--ocre);
  }
</style>
