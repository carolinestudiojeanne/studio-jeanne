---
/**
 * Vidéo d'un projet : sans le son, avec contrôles, dans son format d'origine (verticale ou horizontale).
 * Seules les premières secondes sont lues à l'ouverture de la page, pour afficher la première image.
 */
import {rendreImage} from '../../lib/image'
import type {Projet} from '../../lib/types'

interface Props {
  video: NonNullable<Projet['video']>
  titre: string
}
const {video, titre} = Astro.props
const affiche = rendreImage(video.imageAttente, {ratio: 16 / 9, maxWidth: 1920})

/** Lien Vimeo / YouTube en version sans cookies. */
function intégration(lien: string): string | null {
  const yt = lien.match(/(?:youtube\.com\/watch\?v=|youtu\.be\/|youtube\.com\/shorts\/)([\w-]{6,})/)
  if (yt) return `https://www.youtube-nocookie.com/embed/${yt[1]}`
  const vimeo = lien.match(/vimeo\.com\/(?:video\/)?(\d+)/)
  if (vimeo) return `https://player.vimeo.com/video/${vimeo[1]}?dnt=1`
  return null
}
const iframe = !video.fichierUrl && video.lien ? intégration(video.lien) : null
---

{
  video.fichierUrl ? (
    <video class="video" controls muted playsinline preload="metadata" poster={affiche?.src}>
      <source src={`${video.fichierUrl}#t=0.1`} type="video/mp4" />
    </video>
  ) : iframe ? (
    <div class="video video--iframe">
      <iframe src={iframe} title={`Vidéo du projet ${titre}`} loading="lazy" allow="fullscreen; picture-in-picture" allowfullscreen />
    </div>
  ) : null
}

<style>
  video.video {
    display: block;
    max-width: 100%;
    width: auto;
    height: min(80svh, 42rem);
    border-radius: var(--arrondi);
    background: var(--creme-soutenu);
  }
  .video--iframe {
    width: 100%;
    aspect-ratio: 16 / 9;
  }
  .video--iframe iframe {
    width: 100%;
    height: 100%;
    border: 0;
  }
</style>
