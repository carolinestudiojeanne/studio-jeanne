---
/**
 * Gabarit unique des pages projet (cahier des charges §7.3).
 * Les sections 3 à 6 disparaissent si Caroline ne les remplit pas.
 */
import Base from '../../layouts/Base.astro'
import EnTeteProjet from './EnTeteProjet.astro'
import SectionTexte from '../sections/SectionTexte.astro'
import NavProjets from './NavProjets.astro'
import AppelAction from '../sections/AppelAction.astro'
import ListeAvis from '../sections/ListeAvis.astro'
import Galerie from './Galerie.astro'
import AvantApres from './AvantApres.astro'
import Video from './Video.astro'
import {getReglages} from '../../lib/contenu'
import {texteBrut, texteEnHtml} from '../../lib/texte'
import {canonique, ligneLieu, schemaFilAriane, titreProjet, SITE} from '../../lib/seo'
import {imagePartageUrl} from '../../lib/image'
import type {Projet, ProjetCarte} from '../../lib/types'

interface Props {
  projet: Projet
  tous: ProjetCarte[]
  apercu?: boolean
}
const {projet, tous, apercu = false} = Astro.props
const reglages = await getReglages()
// Bandeau du bas : les projets liés d'abord, puis tous les autres.
// Bas de page : projet précédent et projet suivant, dans l'ordre de la page Projets (en boucle).
const position = tous.findIndex((p) => p.slug === projet.slug)
const precedent = tous.length > 1 && position >= 0 ? tous[(position - 1 + tous.length) % tous.length] : undefined
const suivant = tous.length > 1 && position >= 0 ? tous[(position + 1) % tous.length] : undefined
const pro = projet.categorie === 'professionnel'
const chemin = `/projets/${projet.slug}`
const description = projet.seo?.metaDescription || projet.resume || ''

const filAriane = [
  {nom: 'Accueil', chemin: '/'},
  pro ? {nom: 'Professionnels', chemin: '/professionnels'} : {nom: 'Projets', chemin: '/projets'},
  {nom: projet.titre, chemin},
]

const schemaProjet = {
  '@context': 'https://schema.org',
  '@type': 'CreativeWork',
  name: projet.titre,
  headline: `${projet.titre}, ${ligneLieu(projet)}`,
  description,
  url: canonique(chemin),
  image: imagePartageUrl(projet.imagePrincipale),
  creator: {'@id': `${SITE}/#entreprise`},
  locationCreated: projet.commune ? {'@type': 'Place', name: [projet.commune, projet.departement].filter(Boolean).join(', ')} : undefined,
  dateCreated: projet.annee ? String(projet.annee) : undefined,
  dateModified: projet._updatedAt,
  about: [projet.typeDeProjet, projet.typeDeBien].filter(Boolean).join(' · '),
  text: texteBrut(projet.realisation).slice(0, 500) || undefined,
}

const details = [
  projet.typeDeBien && {libelle: 'Bien', valeur: projet.typeDeBien},
  projet.surface && {libelle: 'Surface', valeur: `${projet.surface} m²`},
  projet.annee && {libelle: 'Année', valeur: String(projet.annee)},
  projet.commune && {libelle: 'Lieu', valeur: [projet.commune, projet.departement].filter(Boolean).join(', ')},
].filter(Boolean) as Array<{libelle: string; valeur: string}>

const realisationHtml = texteEnHtml(projet.realisation)

// Haut de page : une photo verticale (de préférence une photo « par paire ») et une bande qui montre
// 4 photos à la fois ; toutes les autres photos y défilent avec les flèches (plus de longue galerie en bas).
const galerie = projet.galerie ?? []
const iPortrait = Math.max(0, galerie.findIndex((g) => g.affichage === 'paire'))
const portrait = galerie[iPortrait]?.image
const autres = galerie.filter((_, i) => i !== iPortrait)
const bande = autres.length > 1 ? autres : []
const resteGalerie = autres.slice(bande.length)
const caracteristiques = [projet.typeDeProjet && {libelle: 'Projet', valeur: projet.typeDeProjet}, ...details].filter(Boolean) as Array<{
  libelle: string
  valeur: string
}>
---

<Base
  titre={titreProjet(projet, reglages.suffixeTitre)}
  description={description}
  imagePartage={projet.seo?.imagePartage || projet.imagePrincipale}
  schemas={[schemaProjet, schemaFilAriane(filAriane)]}
  type="article"
  noindex={apercu}
>
  {apercu && <div class="apercu">Aperçu du brouillon : cette page n’est pas encore publiée.</div>}

  <!-- 1. Grand visuel, photo à cheval, caractéristiques, textes, bande de photos -->
  <EnTeteProjet projet={projet} portrait={portrait} bande={bande.map((g) => g.image)} caracteristiques={caracteristiques}>
    {
      projet.demande?.length ? (
        <div>
          <h2 class="surtitre">La demande</h2>
          <div class="texte" set:html={texteEnHtml(projet.demande)} />
        </div>
      ) : null
    }
    {
      realisationHtml && (
        <div>
          <h2 class="surtitre">Ce qui a été fait</h2>
          <div class="texte" set:html={realisationHtml} />
        </div>
      )
    }
  </EnTeteProjet>

  <!-- 2. Photos restantes et vidéo -->
  {
    (resteGalerie.length > 0 || (projet.video && (projet.video.fichierUrl || projet.video.lien))) && (
      <section class="section section--serree">
        {resteGalerie.length > 0 && (
          <div class="conteneur galerie-bloc">
            <Galerie galerie={resteGalerie} />
          </div>
        )}
        {projet.video && (projet.video.fichierUrl || projet.video.lien) && (
          <div class="conteneur galerie-bloc">
            <Video video={projet.video} titre={projet.titre} />
          </div>
        )}
      </section>
    )
  }

  <!-- 5. Avant / après -->
  {
    projet.avantApres?.length ? (
      <section class="section fond-soutenu">
        <div class="conteneur">
          <h2>Avant, après</h2>
          <AvantApres paires={projet.avantApres} />
        </div>
      </section>
    ) : null
  }

  <!-- 6. Le retour du client -->
  {
    projet.retourClient?.citation && (
      <SectionTexte surtitre="Le retour du client">
        <ListeAvis avis={[{texte: projet.retourClient.citation, prenom: projet.retourClient.prenom || ''}]} colonnes={false} />
      </SectionTexte>
    )
  }

  <!-- 7. Autres projets -->
  <NavProjets precedent={precedent} suivant={suivant} />

  <!-- 8. Appel à l'action -->
  <AppelAction
    appel={{
      titre: 'Un projet comme celui-ci ?',
      texte: 'Un formulaire d’une dizaine de minutes, puis un échange d’une heure en visio.',
      boutonLibelle: 'Parler de votre projet',
    }}
    lien={{libelle: 'Le détail de l’accompagnement', href: '/accompagnement'}}
  />
</Base>

<style>
  .apercu {
    background: var(--ardoise);
    color: var(--creme);
    text-align: center;
    padding: 0.6rem 1rem;
    font-size: var(--t-s);
  }
  .galerie-bloc + .galerie-bloc {
    margin-top: clamp(1rem, 3vw, 2rem);
  }
</style>
