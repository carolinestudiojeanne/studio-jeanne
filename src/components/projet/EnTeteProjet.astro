---
/**
 * Haut des pages projet : grand visuel avec titre centré, une photo verticale à cheval
 * sur le bas du visuel, les caractéristiques du projet, les textes du projet (passés en slot),
 * une bande de photos sur toute la largeur, puis le bouton « Parlons de votre projet ».
 */
import Image from '../Image.astro'
import type {ImageData, Projet} from '../../lib/types'

interface Props {
  projet: Projet
  /** Photo verticale à cheval sur le visuel. */
  portrait?: ImageData
  /** Photos de la bande pleine largeur (4 au plus). */
  bande: ImageData[]
  /** Caractéristiques du projet (type, bien, surface, année, lieu…). */
  caracteristiques: Array<{libelle: string; valeur: string}>
}
const {projet, portrait, bande, caracteristiques} = Astro.props
---

<section class="ep">
  <div class="ep__visuel">
    <Image image={projet.imagePrincipale} sizes="100vw" prioritaire legende={false} />
    <div class="ep__voile"></div>
    <div class="ep__haut">
      <h1 class="ep__titre">{projet.titre}</h1>
      {projet.resume && <p class="ep__resume">{projet.resume}</p>}
    </div>
  </div>

  {
    portrait && (
      <div class="ep__portrait">
        <Image image={portrait} ratio={4 / 5} legende={false} sizes="(min-width: 52rem) 26vw, 70vw" />
      </div>
    )
  }

  {
    caracteristiques.length > 0 && (
      <dl class="ep__carac">
        {caracteristiques.map((c) => (
          <div>
            <dt>{c.libelle}</dt>
            <dd>{c.valeur}</dd>
          </div>
        ))}
      </dl>
    )
  }

  {
    Astro.slots.has('default') && (
      <div class="ep__textes">
        <slot />
      </div>
    )
  }

  {
    bande.length > 1 && (
      <div class="ep__bande-cadre">
        <ul class="ep__bande">
          {bande.map((image) => (
            <li>
              <Image image={image} ratio={3 / 4} legende={false} sizes="(min-width: 52rem) 28vw, 50vw" />
            </li>
          ))}
        </ul>
      </div>
    )
  }

  <div class="ep__appel">
    <a class="bouton bouton--contour" href="/contact">Parlons de votre projet</a>
  </div>
</section>

<style>
  .ep {
    text-align: center;
    /* Hauteur de la photo verticale qui chevauche le bas du grand visuel. */
    --chevauchement: clamp(9rem, 18vw, 17rem);
  }

  /* 1. Grand visuel, titre en haut sur un léger voile crème */
  .ep__visuel {
    position: relative;
    min-height: min(68svh, 42rem);
    display: flex;
    flex-direction: column;
    align-items: center;
    /* Le titre et la phrase se centrent entre le haut du visuel et le haut de la photo verticale. */
    padding-bottom: var(--chevauchement);
  }
  .ep__visuel > :global(figure),
  .ep__visuel > :global(figure .image__cadre) {
    position: absolute;
    inset: 0;
    height: 100%;
    margin: 0;
  }
  .ep__visuel :global(.image__cadre) {
    border-radius: 0;
  }
  .ep__voile {
    position: absolute;
    inset: 0;
    background: linear-gradient(to bottom, rgb(251 247 239 / 0.9), rgb(251 247 239 / 0.55) 30%, rgb(251 247 239 / 0) 60%);
  }
  .ep__haut {
    position: relative;
    margin-block: auto;
    padding: 2rem var(--gouttiere);
  }
  .ep__titre {
    font-size: var(--t-xl);
    margin-bottom: 1.25rem;
    text-wrap: balance;
  }
  .ep__resume {
    font-size: var(--t-m);
    margin: 0 auto;
    max-width: 34rem;
  }
  /* Sur grand écran, la phrase tient sur une seule ligne. */
  @media (min-width: 72rem) {
    .ep__resume {
      max-width: none;
      white-space: nowrap;
    }
  }

  /* 2. Photo verticale à cheval sur le bas du visuel */
  .ep__portrait {
    position: relative;
    z-index: 1;
    width: clamp(13rem, 26vw, 22rem);
    margin: calc(-1 * var(--chevauchement)) auto 0;
  }

  /* 3. Type de projet et détails */
  /* 3. Caractéristiques du projet, sur une ligne, séparées par un filet */
  .ep__carac {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 1.5rem 0;
    max-width: 64rem;
    margin: 0 auto;
    padding: clamp(2.5rem, 5vw, 4rem) var(--gouttiere) clamp(3rem, 6vw, 5rem);
  }
  .ep__carac > div {
    padding-inline: clamp(1.25rem, 3vw, 2.5rem);
  }
  .ep__carac > div + div {
    border-left: 1px solid color-mix(in srgb, var(--ocre) 60%, transparent);
  }
  .ep__carac dt {
    font-size: var(--t-xs);
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--ardoise);
    margin-bottom: 0.4rem;
  }
  .ep__carac dd {
    margin: 0;
    font-size: var(--t-m);
  }

  /* 4. Textes du projet (la demande, ce qui a été fait), avant les photos */
  .ep__textes {
    text-align: center;
    max-width: calc(64rem + 2 * var(--gouttiere));
    margin: 0 auto;
    padding: 0 var(--gouttiere) clamp(3rem, 6vw, 5rem);
    display: grid;
    gap: clamp(2.5rem, 5vw, 3.5rem);
  }

  /* 5. Bouton sous les photos */
  .ep__appel {
    padding: clamp(2.5rem, 5vw, 4rem) var(--gouttiere) 0;
  }

  /* 4. Bande de photos sur toute la largeur, coupée aux bords */
  .ep__bande-cadre {
    overflow: hidden;
  }
  .ep__bande {
    list-style: none;
    margin: 0 -6%;
    padding: 0;
    display: grid;
    /* Toujours la largeur de 4 photos, même s'il y en a moins (elles restent centrées). */
    grid-auto-flow: column;
    grid-auto-columns: calc((100% - 3 * var(--ecart)) / 4);
    justify-content: center;
    --ecart: clamp(0.5rem, 1vw, 0.875rem);
    gap: var(--ecart);
  }
  @media (max-width: 51.99rem) {
    .ep__bande {
      grid-auto-flow: row;
      grid-template-columns: repeat(2, 1fr);
      margin: 0;
      padding-inline: var(--gouttiere);
    }
  }
</style>
