---
/**
 * Haut des pages projet : grand visuel avec titre centré, une photo verticale à cheval
 * sur le bas du visuel, les caractéristiques du projet, les textes du projet (passés en slot),
 * une bande de photos sur toute la largeur, puis le bouton « Parlons de votre projet »
 * (à droite des avant / après quand il y en a, passés dans le slot « avant-apres »).
 */
import Image from '../Image.astro'
import type {ImageData, Projet} from '../../lib/types'

interface Props {
  projet: Projet
  /** Photo verticale à cheval sur le visuel. */
  portrait?: ImageData
  /** Photos de la bande : 4 visibles à la fois, les autres défilent en boucle avec les flèches. */
  bande: ImageData[]
  /** Caractéristiques du projet (type, bien, surface, année, lieu…). */
  caracteristiques: Array<{libelle: string; valeur: string}>
  /** Des avant / après sont passés dans le slot « avant-apres ». */
  avantApres?: boolean
  /** Une vidéo est passée dans le slot « video » (affichée sous les avant / après). */
  video?: boolean
  /** La vidéo se place à gauche des avant / après (empilés à sa droite) au lieu d'être dessous. */
  videoACote?: boolean
  /** Formulaire Tally du bouton « Parlons de votre projet ». */
  formulaire: string
}
const {projet, portrait, bande, caracteristiques, avantApres = false, video = false, videoACote = false, formulaire} = Astro.props
---

<section class="ep">
  <div class="ep__visuel">
    <Image image={projet.imagePrincipale} sizes="100vw" prioritaire legende={false} />
    <div class="ep__haut">
      <h1 class="ep__titre">{projet.titre}</h1>
      {projet.resume && <p class="ep__resume">{projet.resume}</p>}
    </div>
  </div>

  {
    portrait && (
      <div class="ep__portrait">
        <Image image={portrait} ratio={4 / 5} legende={false} sizes="(min-width: 52rem) 26vw, 70vw" />
      </div>
    )
  }

  {
    caracteristiques.length > 0 && (
      <dl class="ep__carac">
        {caracteristiques.map((c) => (
          <div>
            <dt>{c.libelle}</dt>
            <dd>{c.valeur}</dd>
          </div>
        ))}
      </dl>
    )
  }

  {
    Astro.slots.has('default') && (
      <div class="ep__textes">
        <slot />
      </div>
    )
  }

  {
    bande.length > 1 && (
      <div class:list={['ep__bande-cadre', {'ep__bande-cadre--defile': bande.length > 4}]} data-bande>
        {bande.length > 4 && (
          <button type="button" class="ep__fleche" data-sens="-1" aria-label="Photos précédentes">
            <svg viewBox="0 0 10 18" aria-hidden="true"><path d="M9 1 1 9l8 8" /></svg>
          </button>
        )}
        <div class="ep__bande-fenetre">
          <ul class="ep__bande">
            {bande.map((image) => (
              <li>
                <Image image={image} ratio={3 / 4} sizes="(min-width: 52rem) 24vw, 50vw" />
              </li>
            ))}
          </ul>
        </div>
        {bande.length > 4 && (
          <button type="button" class="ep__fleche" data-sens="1" aria-label="Photos suivantes">
            <svg viewBox="0 0 10 18" aria-hidden="true"><path d="m1 1 8 8-8 8" /></svg>
          </button>
        )}
      </div>
    )
  }

  {
    avantApres ? (
      <div class:list={['ep__appel', 'ep__appel--aa', {'ep__appel--video': videoACote}]}>
        {videoACote && (
          <div class="ep__video-cote">
            <slot name="video" />
          </div>
        )}
        <div class="ep__aa">
          <slot name="avant-apres" />
        </div>
        <a class="bouton bouton--contour" href={formulaire}>Parlons de votre projet</a>
      </div>
    ) : (
      <div class="ep__appel">
        <a class="bouton bouton--contour" href={formulaire}>Parlons de votre projet</a>
      </div>
    )
  }

  {
    video && !videoACote && (
      <div class="ep__video">
        <slot name="video" />
      </div>
    )
  }
</section>

<script>
  // Bande de photos : chaque flèche fait glisser d'une photo ; la photo qui sort d'un côté
  // revient de l'autre, pour tourner en boucle quel que soit le nombre de photos.
  document.querySelectorAll<HTMLElement>('[data-bande]').forEach((cadre) => {
    const piste = cadre.querySelector<HTMLElement>('.ep__bande')!
    let occupe = false
    const pas = () => {
      const li = piste.querySelector('li')!
      return li.getBoundingClientRect().width + (parseFloat(getComputedStyle(piste).columnGap) || 0)
    }
    const glisser = (sens: number) => {
      if (occupe) return
      occupe = true
      const p = pas()
      if (sens < 0) {
        piste.prepend(piste.lastElementChild!)
        piste.style.transition = 'none'
        piste.style.transform = `translateX(${-p}px)`
        piste.getBoundingClientRect()
      }
      piste.style.transition = 'transform 0.5s cubic-bezier(0.2, 0.7, 0.2, 1)'
      piste.style.transform = sens > 0 ? `translateX(${-p}px)` : 'translateX(0)'
      piste.addEventListener(
        'transitionend',
        () => {
          if (sens > 0) piste.append(piste.firstElementChild!)
          piste.style.transition = 'none'
          piste.style.transform = 'translateX(0)'
          occupe = false
        },
        {once: true},
      )
    }
    cadre.querySelectorAll<HTMLButtonElement>('.ep__fleche').forEach((b) => b.addEventListener('click', () => glisser(Number(b.dataset.sens))))
  })
</script>

<style>
  .ep {
    text-align: center;
    /* Hauteur de la photo verticale qui chevauche le bas du grand visuel. */
    --chevauchement: clamp(9rem, 18vw, 17rem);
  }

  /* 1. Grand visuel, titre en haut sur un léger voile crème */
  .ep__visuel {
    position: relative;
    min-height: min(68svh, 42rem);
    display: flex;
    flex-direction: column;
    align-items: center;
    /* Le titre et la phrase se centrent entre le haut du visuel et le haut de la photo verticale. */
    padding-bottom: var(--chevauchement);
  }
  .ep__visuel > :global(figure),
  .ep__visuel > :global(figure .image__cadre) {
    position: absolute;
    inset: 0;
    height: 100%;
    margin: 0;
  }
  .ep__visuel :global(.image__cadre) {
    border-radius: 0;
  }
  .ep__haut {
    position: relative;
    margin-block: auto;
    padding: 2rem var(--gouttiere);
  }
  /* Sans voile sur la photo : texte blanc avec une ombre douce pour rester lisible. */
  .ep__haut {
    color: var(--blanc);
    text-shadow: 0 1px 18px rgb(0 0 0 / 0.45), 0 0 2px rgb(0 0 0 / 0.25);
  }
  .ep__titre {
    color: var(--blanc);
    font-size: var(--t-xl);
    margin-bottom: 1.25rem;
    text-wrap: balance;
  }
  .ep__resume {
    font-size: var(--t-m);
    margin: 0 auto;
    max-width: 34rem;
  }
  /* Sur grand écran, la phrase tient sur une seule ligne. */
  @media (min-width: 72rem) {
    .ep__resume {
      max-width: none;
      white-space: nowrap;
    }
  }

  /* 2. Photo verticale à cheval sur le bas du visuel */
  .ep__portrait {
    position: relative;
    z-index: 1;
    width: clamp(13rem, 26vw, 22rem);
    margin: calc(-1 * var(--chevauchement)) auto 0;
  }

  /* 3. Type de projet et détails */
  /* 3. Caractéristiques du projet, sur une ligne, séparées par un filet */
  .ep__carac {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 1.5rem 0;
    margin: 0 auto;
    padding: clamp(2.5rem, 5vw, 4rem) var(--gouttiere) clamp(3rem, 6vw, 5rem);
  }
  .ep__carac > div {
    padding-inline: clamp(1.25rem, 3vw, 2.5rem);
  }
  /* Sur ordinateur, toutes les caractéristiques tiennent sur une seule ligne. */
  @media (min-width: 64rem) {
    .ep__carac {
      flex-wrap: nowrap;
    }
    .ep__carac dd {
      white-space: nowrap;
    }
  }
  .ep__carac > div + div {
    border-left: 1px solid color-mix(in srgb, var(--ocre) 60%, transparent);
  }
  .ep__carac dt {
    font-size: var(--t-xs);
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--ardoise);
    margin-bottom: 0.4rem;
  }
  .ep__carac dd {
    margin: 0;
    font-size: var(--t-m);
  }

  /* 4. Textes du projet (la demande, ce qui a été fait), avant les photos */
  .ep__textes {
    text-align: center;
    max-width: calc(90rem + 2 * var(--gouttiere));
    margin: 0 auto;
    padding: 0 var(--gouttiere) clamp(3rem, 6vw, 5rem);
    display: grid;
    gap: clamp(2.5rem, 5vw, 3.5rem);
  }

  /* Lignes de longueur égale : pas de dernière ligne avec deux mots. */
  .ep__textes :global(p) {
    text-wrap: balance;
  }

  /* 5. Bouton sous les photos */
  .ep__appel {
    padding: clamp(2.5rem, 5vw, 4rem) var(--gouttiere) clamp(3.5rem, 7vw, 6rem);
  }

  /* Vidéo sous les avant / après, alignée à gauche comme eux. */
  .ep__video {
    max-width: calc(90rem + 2 * var(--gouttiere));
    margin: 0 auto;
    padding: 0 var(--gouttiere) clamp(3.5rem, 7vw, 6rem);
  }
  .ep__appel:has(+ .ep__video) {
    padding-bottom: clamp(2rem, 4vw, 3rem);
  }

  /* Bouton « Parlons de votre projet » plein ocre ; au survol, sans fond (contour et texte ocre). */
  .ep__appel .bouton {
    background: var(--ocre);
    color: var(--blanc);
    border-color: var(--ocre);
  }
  .ep__appel .bouton:hover {
    background: transparent;
    color: var(--ocre);
  }

  /* Avant / après à gauche, bouton à droite (l'un sous l'autre sur mobile). */
  .ep__appel--aa {
    display: grid;
    gap: clamp(2rem, 4vw, 3rem);
    justify-items: center;
    max-width: calc(90rem + 2 * var(--gouttiere));
    margin: 0 auto;
    padding-inline: var(--gouttiere);
    /* Un peu plus d'air entre la bande de photos et les avant / après. */
    padding-top: clamp(3.5rem, 7vw, 6rem);
  }
  .ep__aa {
    text-align: left;
    width: 100%;
  }
  @media (min-width: 64rem) {
    .ep__appel--aa {
      grid-template-columns: 1fr auto;
      align-items: center;
    }
    /* Vidéo à gauche ; à sa droite, les avant / après horizontaux empilés (même hauteur que la vidéo) ;
       puis les verticaux, avec le bouton dessous, alignés à gauche. */
    .ep__appel--video {
      grid-template-columns: auto auto auto;
      grid-template-rows: auto 1fr;
      row-gap: 0;
      justify-items: start;
      align-items: start;
      /* L'ensemble (vidéo, avant / après, bouton) est centré dans la page. */
      justify-content: center;
    }
    .ep__appel--video .ep__aa,
    .ep__appel--video :global(.aa-groupes) {
      display: contents;
    }
    .ep__appel--video .ep__video-cote {
      grid-column: 1;
      grid-row: 1 / span 2;
    }
    .ep__appel--video :global(.aa-liste--colonne) {
      grid-column: 2;
      grid-row: 1 / span 2;
    }
    .ep__appel--video :global(.aa-liste--verticaux) {
      grid-column: 3;
      grid-row: 1;
    }
    /* Bouton centré dans l'espace sous l'avant / après vertical (jusqu'au bas de la vidéo). */
    .ep__appel--video > .bouton {
      grid-column: 3;
      grid-row: 2;
      justify-self: center;
      align-self: center;
    }
  }

  /* 4. Bande de photos sur toute la largeur : 4 visibles, les autres défilent avec les flèches */
  .ep__bande-cadre {
    display: flex;
    align-items: center;
    gap: clamp(0.25rem, 1.5vw, 1rem);
    padding-inline: clamp(0.25rem, 1.5vw, 1rem);
  }
  .ep__bande-fenetre {
    flex: 1;
    min-width: 0;
    overflow: hidden;
  }
  .ep__bande {
    --ecart: clamp(0.5rem, 1vw, 0.875rem);
    --visibles: 4;
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    gap: var(--ecart);
  }
  /* Moins de 4 photos : elles restent centrées. */
  .ep__bande-cadre:not(.ep__bande-cadre--defile) .ep__bande {
    justify-content: center;
  }
  .ep__bande li {
    flex: none;
    width: calc((100% - (var(--visibles) - 1) * var(--ecart)) / var(--visibles));
  }
  .ep__bande :global(figcaption) {
    margin-top: 0.5rem;
    font-size: var(--t-xs);
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }
  @media (max-width: 51.99rem) {
    .ep__bande {
      --visibles: 2;
    }
  }
  /* Têtes de flèches fines, en ocre (comme le carrousel de l'accueil) ; elles glissent un peu vers l'extérieur au survol. */
  .ep__fleche {
    flex: none;
    background: none;
    border: 0;
    padding: 0.75rem 0.5rem;
    color: var(--ocre);
    line-height: 0;
    cursor: pointer;
    transition: transform 0.25s;
  }
  .ep__fleche[data-sens='-1']:hover {
    transform: translateX(-4px);
  }
  .ep__fleche[data-sens='1']:hover {
    transform: translateX(4px);
  }
  .ep__fleche svg {
    width: 0.7rem;
    height: auto;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.2;
    overflow: visible;
  }
</style>
