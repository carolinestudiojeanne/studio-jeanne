---
/**
 * Avant / après : un curseur à faire glisser, utilisable au clavier.
 * Le format suit la plus étroite des deux photos (si l'une est verticale, le cadre est vertical),
 * et tous les avant / après ont la même hauteur, côte à côte, alignés à gauche.
 */
import {rendreImage} from '../../lib/image'
import type {ImageData, Projet} from '../../lib/types'

interface Props {
  paires: NonNullable<Projet['avantApres']>
  /** À droite d'une vidéo : un avant / après par ligne, l'ensemble ayant la hauteur de la vidéo. */
  colonne?: boolean
}
const {paires, colonne = false} = Astro.props

/** Largeur / hauteur d'origine (recadrage Sanity compris), lue dans la référence (image-<id>-3000x2000-jpg). */
const proportion = (image?: ImageData) => {
  const m = image?.asset?._ref.match(/-(\d+)x(\d+)-/)
  if (!m) return 3 / 2
  const c = (image as {crop?: {left: number; right: number; top: number; bottom: number}}).crop
  const w = Number(m[1]) * (c ? 1 - c.left - c.right : 1)
  const h = Number(m[2]) * (c ? 1 - c.top - c.bottom : 1)
  return w / h
}
const RATIOS = {paysage: 3 / 2, carre: 1, portrait: 4 / 5}
const items = paires
  .map((p) => {
    const r = Math.min(proportion(p.avant), proportion(p.apres))
    const format = r < 0.87 ? 'portrait' : r > 1.15 ? 'paysage' : 'carre'
    const ratio = RATIOS[format]
    const opts = {ratio, maxWidth: 1400}
    const sizes = `(min-width: 52rem) ${Math.round(20 * ratio)}rem, ${Math.round(14 * ratio)}rem`
    return {format, ratio, sizes, avant: rendreImage(p.avant, opts), apres: rendreImage(p.apres, opts), legende: p.legende}
  })
  .filter((p) => p.avant && p.apres)
// Rangées de 3 au plus : dans une rangée, la largeur de chaque cadre est proportionnelle à son format,
// ce qui leur donne exactement la même hauteur.
const rangees: (typeof items)[] = []
for (let i = 0; i < items.length; i += 3) rangees.push(items.slice(i, i + 3))
// À côté d'une vidéo : 1 ou 2 avant / après empilés (chacun de la moitié de la hauteur de la vidéo) ;
// 3 avant / après : les horizontaux (et carrés) empilés, les verticaux dans une colonne à part.
const horizontaux = items.filter((p) => p.format !== 'portrait')
const verticaux = items.filter((p) => p.format === 'portrait')
const separer = items.length >= 3 && horizontaux.length > 0 && verticaux.length > 0
const groupes = !colonne
  ? [{classe: '', total: items.length, rangees}]
  : separer
    ? [
        {classe: 'aa-liste--colonne', total: Math.max(horizontaux.length, 2), rangees: horizontaux.map((p) => [p])},
        {classe: 'aa-liste--verticaux', total: verticaux.length, rangees: verticaux.map((p) => [p])},
      ]
    : [{classe: 'aa-liste--colonne', total: Math.max(items.length, 2), rangees: items.map((p) => [p])}]
---

<div class="aa-groupes">
{
  groupes.map((g) => (
<div class:list={['aa-liste', g.classe]} style={`--total: ${g.total}`}>
  {
    g.rangees.map((rangee) => (
      <div class="aa-rangee" style={`--somme: ${rangee.reduce((t, p) => t + p.ratio, 0)}; --n: ${rangee.length}`}>
        {rangee.map((p) => (
          <figure class:list={['aa', `aa--${p.format}`]} style={`--r: ${p.ratio}`}>
            <div class="aa__cadre" style={`aspect-ratio: ${p.ratio}`}>
              <img class="aa__img" src={p.apres!.src} srcset={p.apres!.srcset} sizes={p.sizes} width={p.apres!.width} height={p.apres!.height} alt={`Après : ${p.apres!.alt}`} loading="lazy" />
              <div class="aa__cote-apres" aria-hidden="true">
                <span class="aa__etiquette aa__etiquette--apres">Après</span>
              </div>
              <div class="aa__avant">
                <img class="aa__img" src={p.avant!.src} srcset={p.avant!.srcset} sizes={p.sizes} width={p.avant!.width} height={p.avant!.height} alt={`Avant : ${p.avant!.alt}`} loading="lazy" />
                <span class="aa__etiquette aa__etiquette--avant" aria-hidden="true">Avant</span>
              </div>
              <div class="aa__poignee" aria-hidden="true" />
              <input class="aa__curseur" type="range" min="0" max="100" value="50" aria-label="Comparer avant et après" aria-valuetext="Avant 50 %, après 50 %" />
            </div>
            {p.legende && <figcaption>{p.legende}</figcaption>}
          </figure>
        ))}
      </div>
    ))
  }
</div>
  ))
}
</div>

<script>
  document.querySelectorAll<HTMLElement>('.aa__cadre').forEach((cadre) => {
    const curseur = cadre.querySelector<HTMLInputElement>('.aa__curseur')
    const maj = () => {
      const v = Number(curseur?.value ?? 50)
      cadre.style.setProperty('--pos', `${v}%`)
      curseur?.setAttribute('aria-valuetext', `Avant ${v} %, après ${100 - v} %`)
    }
    curseur?.addEventListener('input', maj)
    maj()
  })
</script>

<style>
  /* Groupes d'avant / après (horizontaux / verticaux à côté d'une vidéo) : même écart entre eux qu'entre les avant / après. */
  .aa-groupes {
    display: grid;
    gap: clamp(1rem, 2vw, 1.5rem);
  }
  .aa-liste {
    --ecart: clamp(1rem, 2vw, 1.5rem);
    /* Hauteur commune des avant / après. */
    --hauteur: 14rem;
    display: grid;
    gap: var(--ecart);
  }
  .aa {
    margin: 0;
  }
  /* Mobile : l'un sous l'autre, tous à la même hauteur. */
  .aa-rangee {
    display: grid;
    gap: var(--ecart);
    justify-items: start;
  }
  .aa-rangee .aa {
    width: min(100%, calc(var(--hauteur) * var(--r)));
  }
  /* Ordinateur : côte à côte, largeur proportionnelle au format, donc même hauteur ;
     la rangée ne dépasse pas la hauteur commune. */
  @media (min-width: 52rem) {
    .aa-liste {
      --hauteur: 20rem;
    }
    .aa-rangee {
      display: flex;
      max-width: calc(var(--hauteur) * var(--somme) + (var(--n) - 1) * var(--ecart));
    }
    .aa-rangee .aa {
      flex: var(--r) 1 0%;
      width: auto;
      min-width: 0;
    }
  }
  /* À droite d'une vidéo (ordinateur) : les avant / après empilés occupent exactement la hauteur de la vidéo. */
  @media (min-width: 64rem) {
    .aa-liste--colonne {
      --hauteur: calc((var(--h-video, min(80svh, 42rem)) - (var(--total) - 1) * var(--ecart)) / var(--total));
    }
    .aa-liste--colonne .aa-rangee .aa,
    .aa-liste--verticaux .aa-rangee .aa {
      flex: none;
      width: calc(var(--hauteur) * var(--r));
    }
    /* Les verticaux, un peu plus grands, au-dessus du bouton. */
    .aa-liste--verticaux {
      --hauteur: calc(var(--h-video, min(80svh, 42rem)) * 0.62 / var(--total));
    }
  }
  .aa figcaption {
    margin-top: 0.5rem;
    font-size: var(--t-xs);
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }
  .aa__cadre {
    --pos: 50%;
    position: relative;
    overflow: hidden;
    border-radius: var(--arrondi);
    background: var(--creme-soutenu);
  }
  .aa__img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  /* Chaque étiquette est coupée par le trait, comme sa photo : « Avant » reste dans la partie gauche,
     « Après » dans la partie droite ; quand on glisse jusqu'au bout, celle du côté masqué disparaît. */
  .aa__avant {
    position: absolute;
    inset: 0;
    clip-path: inset(0 calc(100% - var(--pos)) 0 0);
  }
  .aa__cote-apres {
    position: absolute;
    inset: 0;
    clip-path: inset(0 0 0 var(--pos));
    pointer-events: none;
  }
  .aa__poignee {
    position: absolute;
    top: 0;
    bottom: 0;
    left: var(--pos);
    width: 2px;
    margin-left: -1px;
    background: var(--creme);
    pointer-events: none;
  }
  .aa__poignee::after {
    content: '‹ ›';
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    width: 2.25rem;
    height: 2.25rem;
    display: grid;
    place-items: center;
    border-radius: 50%;
    background: var(--creme);
    color: var(--ardoise);
    font-size: 0.9rem;
    letter-spacing: 0.1em;
  }
  .aa__curseur {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    opacity: 0;
    cursor: ew-resize;
    margin: 0;
  }
  .aa__curseur:focus-visible + .aa__poignee,
  .aa__cadre:has(.aa__curseur:focus-visible) {
    outline: 2px solid var(--ardoise);
    outline-offset: 3px;
  }
  /* Petites étiquettes fines : fond crème du site, texte ocre. */
  .aa__etiquette {
    position: absolute;
    top: 0.75rem;
    padding: 0.2rem 0.55rem;
    background: var(--creme);
    color: var(--ocre);
    font-size: 0.625rem;
    font-weight: 300;
    line-height: 1.4;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    border-radius: 999px;
  }
  .aa__etiquette--avant {
    left: 0.75rem;
  }
  .aa__etiquette--apres {
    right: 0.75rem;
  }
</style>
