---
/**
 * Avant / après : un curseur à faire glisser, utilisable au clavier.
 * Le format suit la photo « après » (paysage 3:2, carré, ou vertical 4:5), à une taille modérée
 * pour rester net, alignées à gauche les unes à côté des autres.
 */
import {rendreImage} from '../../lib/image'
import type {ImageData, Projet} from '../../lib/types'

interface Props {
  paires: NonNullable<Projet['avantApres']>
}
const {paires} = Astro.props

/** Largeur / hauteur d'origine, lue dans la référence Sanity (image-<id>-3000x2000-jpg). */
const proportion = (image?: ImageData) => {
  const m = image?.asset?._ref.match(/-(\d+)x(\d+)-/)
  return m ? Number(m[1]) / Number(m[2]) : 3 / 2
}
const FORMATS = {
  paysage: {ratio: 3 / 2, sizes: '(min-width: 52rem) 30rem, 92vw'},
  carre: {ratio: 1, sizes: '(min-width: 52rem) 23rem, 92vw'},
  portrait: {ratio: 4 / 5, sizes: '(min-width: 52rem) 19rem, 80vw'},
}
const items = paires
  .map((p) => {
    const r = proportion(p.apres)
    const format = r > 1.15 ? 'paysage' : r < 0.87 ? 'portrait' : 'carre'
    const {ratio} = FORMATS[format]
    const opts = {ratio, maxWidth: 1400}
    return {format, ratio, sizes: FORMATS[format].sizes, avant: rendreImage(p.avant, opts), apres: rendreImage(p.apres, opts), legende: p.legende}
  })
  .filter((p) => p.avant && p.apres)
---

<div class:list={['aa-liste', {'aa-liste--nombreux': items.length > 3}]}>
  {
    items.map((p) => (
      <figure class:list={['aa', `aa--${p.format}`]}>
        <div class="aa__cadre" style={`aspect-ratio: ${p.ratio}`}>
          <img class="aa__img" src={p.apres!.src} srcset={p.apres!.srcset} sizes={p.sizes} width={p.apres!.width} height={p.apres!.height} alt={`Après : ${p.apres!.alt}`} loading="lazy" />
          <div class="aa__avant">
            <img class="aa__img" src={p.avant!.src} srcset={p.avant!.srcset} sizes={p.sizes} width={p.avant!.width} height={p.avant!.height} alt={`Avant : ${p.avant!.alt}`} loading="lazy" />
          </div>
          <span class="aa__etiquette aa__etiquette--avant" aria-hidden="true">Avant</span>
          <span class="aa__etiquette aa__etiquette--apres" aria-hidden="true">Après</span>
          <div class="aa__poignee" aria-hidden="true" />
          <input class="aa__curseur" type="range" min="0" max="100" value="50" aria-label="Comparer avant et après" />
        </div>
        {p.legende && <figcaption>{p.legende}</figcaption>}
      </figure>
    ))
  }
</div>

<script>
  document.querySelectorAll<HTMLElement>('.aa__cadre').forEach((cadre) => {
    const curseur = cadre.querySelector<HTMLInputElement>('.aa__curseur')
    const maj = () => cadre.style.setProperty('--pos', `${curseur?.value ?? 50}%`)
    curseur?.addEventListener('input', maj)
    maj()
  })
</script>

<style>
  .aa-liste {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-start;
    gap: clamp(1rem, 2vw, 1.5rem);
  }
  .aa {
    margin: 0;
    width: 100%;
  }
  /* Sur ordinateur, les avant / après se rangent côte à côte et rétrécissent un peu pour tenir sur une ligne. */
  @media (min-width: 52rem) {
    .aa-liste:not(.aa-liste--nombreux) {
      flex-wrap: nowrap;
    }
    .aa {
      flex: 0 1 30rem;
      min-width: 0;
    }
    .aa--carre {
      flex-basis: 23rem;
    }
    .aa--portrait {
      flex-basis: 19rem;
    }
  }
  @media (max-width: 51.99rem) {
    .aa--portrait {
      width: 80%;
    }
  }
  .aa figcaption {
    margin-top: 0.5rem;
    font-size: var(--t-xs);
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }
  .aa__cadre {
    --pos: 50%;
    position: relative;
    overflow: hidden;
    border-radius: var(--arrondi);
    background: var(--creme-soutenu);
  }
  .aa__img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .aa__avant {
    position: absolute;
    inset: 0;
    clip-path: inset(0 calc(100% - var(--pos)) 0 0);
  }
  .aa__poignee {
    position: absolute;
    top: 0;
    bottom: 0;
    left: var(--pos);
    width: 2px;
    margin-left: -1px;
    background: var(--creme);
    pointer-events: none;
  }
  .aa__poignee::after {
    content: '‹ ›';
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    width: 2.25rem;
    height: 2.25rem;
    display: grid;
    place-items: center;
    border-radius: 50%;
    background: var(--creme);
    color: var(--ardoise);
    font-size: 0.9rem;
    letter-spacing: 0.1em;
  }
  .aa__curseur {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    opacity: 0;
    cursor: ew-resize;
    margin: 0;
  }
  .aa__curseur:focus-visible + .aa__poignee,
  .aa__cadre:has(.aa__curseur:focus-visible) {
    outline: 2px solid var(--ardoise);
    outline-offset: 3px;
  }
  /* Petites étiquettes fines, en ocre. */
  .aa__etiquette {
    position: absolute;
    top: 0.75rem;
    padding: 0.2rem 0.55rem;
    background: var(--ocre);
    color: var(--blanc);
    font-size: 0.625rem;
    font-weight: 300;
    line-height: 1.4;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    border-radius: 999px;
  }
  .aa__etiquette--avant {
    left: 0.75rem;
  }
  .aa__etiquette--apres {
    right: 0.75rem;
  }
</style>
