---
/**
 * Gabarit commun à L'accompagnement et Trouver votre bien : même rythme de sections,
 * puisque c'est la même offre par une autre porte (cahier des charges §7.4 et §7.5).
 */
import Base from '../layouts/Base.astro'
import SectionTexte from './sections/SectionTexte.astro'
import IntroPage from './sections/IntroPage.astro'
import TexteImage from './sections/TexteImage.astro'
import AppelAction from './sections/AppelAction.astro'
import Bande from './sections/Bande.astro'
import type {PageOffre} from '../lib/types'

interface Props {
  page: PageOffre
  titre: string
  /** Page vers laquelle mène la ligne d'aiguillage du haut. */
  aiguillageHref: string
  lienSortant?: {libelle?: string; href?: string}
  /** Formulaire Tally de la page (bouton de fin de page). */
  formulaire: string
  /** Masque les trois temps et les deux textes courts (L'accompagnement : remplacés par le déroulé en arche). */
  sansTemps?: boolean
  /** Fin de page resserrée (L'accompagnement) : un bouton juste après l'arche, puis une bande beige vers l'autre page,
      au format de la bande « projet précédent / suivant » des pages projet. Remplace la ligne d'aiguillage et l'appel à l'action. */
  finBande?: boolean
  /** Libellé du bouton de fin de page resserrée. */
  boutonFin?: string
}
const {page, titre, aiguillageHref, lienSortant, formulaire, sansTemps = false, finBande = false, boutonFin = 'Parlons de votre projet'} = Astro.props
const numeros = ['Premier temps', 'Deuxième temps', 'Troisième temps']
---

<Base titre={titre} description={page.seo?.metaDescription} imagePartage={page.seo?.imagePartage}>
  <!-- 2. Titre et introduction -->
  <IntroPage titre={page.intro?.titre} texte={page.intro?.texte} />

  <!-- 2 bis. Contenu propre à la page (déroulé en arche sur L'accompagnement) -->
  <slot name="apres-intro" />

  <!-- 3. Trois temps, texte et image en alternance -->
  {
    !sansTemps && page.etapes?.length ? (
      <section class="section fond-soutenu">
        <div class="conteneur">
          {page.etapes.map((bloc, i) => (
            <TexteImage bloc={bloc} inverse={i % 2 === 1} numero={page.etapes!.length === 3 ? numeros[i] : undefined} />
          ))}
        </div>
      </section>
    ) : null
  }

  <!-- 4 et 5. Deux textes courts -->
  {
    !sansTemps && (
      <>
        <SectionTexte titre={page.texteA?.titre} texte={page.texteA?.texte} />
        <SectionTexte titre={page.texteB?.titre} texte={page.texteB?.texte} serree />
      </>
    )
  }

  <!-- Fin de page resserrée : bouton, puis bande vers l'autre porte d'entrée -->
  {
    finBande && (
      <>
        <div class="fin-bouton">
          <a class="bouton" href={formulaire}>{boutonFin}</a>
          {page.appel?.texte && <p class="fin-bouton__info">{page.appel.texte}</p>}
          {lienSortant?.href && lienSortant.libelle && (
            <p class="fin-bouton__sortant">
              <a href={lienSortant.href} target="_blank" rel="noopener" class="lien-fleche lien-chevron">{lienSortant.libelle}</a>
            </p>
          )}
        </div>
        {page.aiguillage?.texte && <Bande texte={page.aiguillage.texte} lien={page.aiguillage.lienLibelle || 'En savoir plus'} href={aiguillageHref} deuxPoints />}
      </>
    )
  }

  <!-- Ligne d'aiguillage vers l'autre porte d'entrée, en fin de page -->
  {
    !finBande && page.aiguillage?.texte && (
      <div class="aiguillage-ligne">
        <div class="conteneur">
          {page.aiguillage.texte} <a href={aiguillageHref}>{page.aiguillage.lienLibelle || 'En savoir plus'}</a>
        </div>
      </div>
    )
  }


  <!-- 7. Appel à l'action -->
  {!finBande && <AppelAction appel={page.appel} href={formulaire} />}

  {
    !finBande && lienSortant?.href && lienSortant.libelle && (
      <div class="conteneur lien-sortant">
        <a href={lienSortant.href} target="_blank" rel="noopener" class="lien-fleche lien-chevron">
          {lienSortant.libelle}
        </a>
      </div>
    )
  }
</Base>

<style>
  .aiguillage-ligne {
    background: var(--creme-soutenu);
    padding-block: 0.9rem;
    font-size: var(--t-s);
    text-align: center;
  }
  /* Même espace sous le texte en italique qu'entre la fin de l'arche et le bouton (marge de section). */
  .fin-bouton {
    text-align: center;
    padding-bottom: var(--section);
    padding-inline: var(--gouttiere);
  }
  /* Bouton plein ocre ; au survol, il devient sans fond, au trait ocre. */
  .fin-bouton .bouton {
    background: var(--ocre);
    color: var(--blanc);
    border-color: var(--ocre);
  }
  .fin-bouton .bouton:hover {
    background: transparent;
    color: var(--ocre);
  }
  /* Même taille que le texte de la page ; les retours à la ligne saisis dans le Studio sont respectés. */
  .fin-bouton__sortant {
    margin: 1.5rem 0 0;
  }
  .fin-bouton__info {
    margin: 1.25rem 0 0;
    font-style: italic;
    white-space: pre-line;
  }
  .lien-sortant {
    padding-block: 2.5rem;
    text-align: center;
  }
</style>
