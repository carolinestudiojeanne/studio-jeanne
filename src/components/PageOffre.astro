---
/**
 * Gabarit commun à L'accompagnement et Trouver votre bien : même rythme de sections,
 * puisque c'est la même offre par une autre porte (cahier des charges §7.4 et §7.5).
 */
import Base from '../layouts/Base.astro'
import SectionTexte from './sections/SectionTexte.astro'
import TexteImage from './sections/TexteImage.astro'
import Faq from './sections/Faq.astro'
import AppelAction from './sections/AppelAction.astro'
import {schemaFaq} from '../lib/seo'
import type {PageOffre} from '../lib/types'

interface Props {
  page: PageOffre
  titre: string
  /** Page vers laquelle mène la ligne d'aiguillage du haut. */
  aiguillageHref: string
  lienSortant?: {libelle?: string; href?: string}
}
const {page, titre, aiguillageHref, lienSortant} = Astro.props
const numeros = ['Premier temps', 'Deuxième temps', 'Troisième temps']
---

<Base titre={titre} description={page.seo?.metaDescription} imagePartage={page.seo?.imagePartage} schemas={[schemaFaq(page.faq)]}>
  <!-- 1. Ligne d'aiguillage -->
  {
    page.aiguillage?.texte && (
      <div class="aiguillage-ligne">
        <div class="conteneur">
          {page.aiguillage.texte} <a href={aiguillageHref}>{page.aiguillage.lienLibelle || 'En savoir plus'}</a>
        </div>
      </div>
    )
  }

  <!-- 2. Titre et introduction -->
  <SectionTexte titre={page.intro?.titre} niveau="h1" texte={page.intro?.texte} />

  <!-- 3. Trois temps, texte et image en alternance -->
  {
    page.etapes?.length ? (
      <section class="section fond-soutenu">
        <div class="conteneur">
          {page.etapes.map((bloc, i) => (
            <TexteImage bloc={bloc} inverse={i % 2 === 1} numero={page.etapes!.length === 3 ? numeros[i] : undefined} />
          ))}
        </div>
      </section>
    ) : null
  }

  <!-- 4 et 5. Deux textes courts -->
  <SectionTexte titre={page.texteA?.titre} texte={page.texteA?.texte} />
  <SectionTexte titre={page.texteB?.titre} texte={page.texteB?.texte} serree />

  <!-- 6. Questions fréquentes -->
  <Faq faq={page.faq} />

  <!-- 7. Appel à l'action -->
  <AppelAction appel={page.appel} />

  {
    lienSortant?.href && lienSortant.libelle && (
      <div class="conteneur lien-sortant">
        <a href={lienSortant.href} target="_blank" rel="noopener" class="lien-fleche">
          {lienSortant.libelle}
        </a>
      </div>
    )
  }
</Base>

<style>
  .aiguillage-ligne {
    background: var(--creme-soutenu);
    padding-block: 0.9rem;
    font-size: var(--t-s);
    text-align: center;
  }
  .lien-sortant {
    padding-block: 2.5rem;
    text-align: center;
  }
</style>
