---
/**
 * Logo validé (octobre 2026) : filet ocre en angle arrondi, « studio jeanne » en ardoise,
 * « intérieurs » en ocre. Redessiné en SVG d'après le fichier d'Edith (Studio Jeanne - LOGO.png)
 * pour rester net à toutes les tailles. Version claire : texte crème, pour fond ardoise.
 */
interface Props {
  clair?: boolean
  class?: string
}
const {clair = false, class: classe} = Astro.props
---

<svg class:list={['logo', {'logo--clair': clair}, classe]} viewBox="0 0 910 510" role="img" aria-label="Studio Jeanne, intérieurs">
  <path class="logo__filet" d="M18 510 V225 A205 205 0 0 1 223 20 H910" />
  <text class="logo__nom" x="168" y="240" textLength="640" lengthAdjust="spacing">studio</text>
  <text class="logo__nom" x="168" y="395" textLength="632" lengthAdjust="spacing">jeanne</text>
  <text class="logo__metier" x="578" y="492" textLength="322" lengthAdjust="spacing">intérieurs</text>
</svg>

<style>
  .logo {
    display: block;
    width: 7.5rem;
    height: auto;
    overflow: visible;
    font-family: var(--police);
  }
  .logo__filet {
    fill: none;
    stroke: var(--ocre);
    stroke-width: 10;
  }
  .logo__nom {
    font-size: 172px;
    fill: var(--ardoise);
  }
  .logo__metier {
    font-size: 50px;
    fill: var(--ocre);
  }
  .logo--clair .logo__nom {
    fill: var(--creme);
  }
</style>
