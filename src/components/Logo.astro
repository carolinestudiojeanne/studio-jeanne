---
/**
 * Logo provisoire (arche ocre + « studio jeanne » + INTÉRIEURS).
 * À remplacer par les fichiers SVG définitifs : déposer logo.svg et logo-clair.svg dans /public
 * puis utiliser <img> ici. La mise en page autour ne bouge pas.
 */
interface Props {
  clair?: boolean
  class?: string
}
const {clair = false, class: classe} = Astro.props
---

<span class:list={['logo', {'logo--clair': clair}, classe]}>
  <svg class="logo__arche" viewBox="0 0 40 52" aria-hidden="true">
    <path d="M6 50 V24 A14 14 0 0 1 9.5 14.6" />
    <path d="M14.5 10.6 A14 14 0 0 1 34 24 V50" />
  </svg>
  <span class="logo__texte">
    <span class="logo__nom">studio jeanne</span>
    <span class="logo__metier">Intérieurs</span>
  </span>
</span>

<style>
  .logo {
    display: inline-flex;
    align-items: flex-end;
    gap: 0.7rem;
    color: var(--ardoise);
    line-height: 1;
  }
  .logo--clair {
    color: var(--creme);
  }
  .logo__arche {
    width: 1.9rem;
    height: auto;
    fill: none;
    stroke: var(--ocre);
    stroke-width: 3;
    stroke-linecap: round;
  }
  .logo__texte {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
  }
  .logo__nom {
    font-size: 1.35rem;
    letter-spacing: 0.04em;
  }
  .logo__metier {
    font-size: 0.6rem;
    letter-spacing: 0.42em;
    text-transform: uppercase;
  }
</style>
