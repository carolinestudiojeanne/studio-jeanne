---
/**
 * Bande beige minimaliste en bas de page, au format de la bande « projet précédent / suivant » des pages projet :
 * une phrase en capitales espacées, puis à droite le lien en ocre, sans soulignement. Toute la bande est cliquable.
 */
interface Props {
  texte: string
  lien: string
  href: string
  /** Ouvre le lien dans un nouvel onglet (formulaire externe). */
  externe?: boolean
  /** Phrase courte facultative, en italique sous la ligne principale. */
  description?: string
  /** Termine la phrase par « : » (« La première étape : Remplir le formulaire ») ; un « ? » final est remplacé par « : ». */
  deuxPoints?: boolean
  /** Garde la description sur une seule ligne sur ordinateur (la bande s'élargit, la taille ne change pas). */
  descriptionUneLigne?: boolean
}
const {texte, lien, href, externe = false, description, deuxPoints = false, descriptionUneLigne = false} = Astro.props
const phrase = deuxPoints ? `${texte.replace(/\s*[?:]\s*$/, '').trim()} :` : texte
---

<a class:list={['bande', {'bande--deux-points': deuxPoints}]} href={href} {...(externe ? {target: '_blank', rel: 'noopener'} : {})}>
  <span class="bande__texte">{phrase}</span>
  <span class="bande__lien">{lien}</span>
  {description && <span class:list={['bande__description', {'bande__description--une-ligne': descriptionUneLigne}]}>{description}</span>}
</a>

<style>
  .bande {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    align-items: baseline;
    gap: 0.4rem 1.25rem;
    padding: clamp(1.75rem, 3.5vw, 2.5rem) var(--gouttiere);
    background: var(--creme-soutenu);
    text-align: center;
    text-decoration: none;
    font-size: var(--t-s);
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }
  /* Après « : », le même espace qu'avant (une espace de la police, espacement des lettres compris). */
  .bande--deux-points {
    column-gap: 0.41em;
  }
  .bande__texte {
    color: var(--ardoise);
  }
  .bande__lien {
    color: var(--ocre);
  }
  /* Description : ligne entière sous la phrase, en italique, à la taille du texte courant. */
  .bande__description {
    flex-basis: 100%;
    margin-top: 0.35rem;
    font-size: var(--t-m);
    color: var(--ardoise);
    font-style: italic;
    letter-spacing: 0.02em;
    text-transform: none;
  }
  @media (min-width: 64rem) {
    .bande__description--une-ligne {
      white-space: nowrap;
    }
  }
</style>
