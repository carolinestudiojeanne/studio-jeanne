---
/**
 * S1 : grand visuel plein écran + titre + sous-titre + bouton.
 * Avec plusieurs images (accueil), elles se succèdent en fondu toutes les 7 secondes.
 */
import Image from '../Image.astro'
import type {ImageData} from '../../lib/types'

interface Props {
  image?: ImageData
  /** Diaporama : remplace `image` quand il y a au moins deux images. */
  images?: ImageData[]
  /** Petite ligne au-dessus du titre (sur l'accueil, c'est elle le H1). */
  surtitre?: string
  surtitreEstH1?: boolean
  titre?: string
  sousTitre?: string
  bouton?: {libelle?: string; href: string}
  /** Texte centré, grand titre sur deux lignes (accueil). */
  centre?: boolean
}
const {image, images = [], surtitre, surtitreEstH1 = false, titre, sousTitre, bouton, centre = false} = Astro.props
const diaporama = images.length > 1 ? images : []
const TitreTag = surtitreEstH1 ? 'p' : 'h1'
const SurtitreTag = surtitreEstH1 ? 'h1' : 'p'
---

<section class:list={['hero', {'hero--centre': centre}]}>
  {
    diaporama.length ? (
      <div class="hero__image hero__diaporama" data-diaporama>
        {diaporama.map((img, i) => (
          <div class:list={['hero__diapo', {'est-visible': i === 0}]}>
            <Image image={img} sizes="100vw" prioritaire={i === 0} legende={false} />
          </div>
        ))}
      </div>
    ) : (
      <div class="hero__image">
        <Image image={image} sizes="100vw" prioritaire legende={false} />
      </div>
    )
  }
  <div class="hero__voile"></div>
  <div class="conteneur hero__contenu">
    {surtitre && <SurtitreTag class="surtitre hero__surtitre">{surtitre}</SurtitreTag>}
    {titre && <TitreTag class="hero__titre">{titre}</TitreTag>}
    {sousTitre && <p class="hero__sous-titre">{sousTitre}</p>}
    {bouton?.libelle && <a class="bouton bouton--clair" href={bouton.href}>{bouton.libelle}</a>}
    <slot />
  </div>
</section>

<script>
  // Diaporama du grand visuel : une image toutes les 7 secondes, en fondu.
  document.querySelectorAll<HTMLElement>('[data-diaporama]').forEach((zone) => {
    const diapos = [...zone.querySelectorAll<HTMLElement>('.hero__diapo')]
    if (diapos.length < 2) return
    let i = 0
    setInterval(() => {
      diapos[i].classList.remove('est-visible')
      i = (i + 1) % diapos.length
      diapos[i].classList.add('est-visible')
    }, 7000)
  })
</script>

<style>
  .hero {
    position: relative;
    min-height: min(88svh, 60rem);
    display: flex;
    align-items: flex-end;
    color: var(--creme);
    overflow: hidden;
  }
  .hero__image,
  .hero__image :global(figure),
  .hero__image :global(.image__cadre) {
    position: absolute;
    inset: 0;
    height: 100%;
  }
  .hero__diapo {
    position: absolute;
    inset: 0;
    opacity: 0;
    transition: opacity 1.6s ease;
  }
  .hero__diapo.est-visible {
    opacity: 1;
  }
  /* Mouvements réduits demandés : les images changent quand même, mais sans fondu. */
  @media (prefers-reduced-motion: reduce) {
    .hero__diapo {
      transition: none;
    }
  }
  .hero__diapo :global(figure),
  .hero__diapo :global(.image__cadre) {
    position: absolute;
    inset: 0;
    height: 100%;
    margin: 0;
  }
  /* Grand visuel plein écran : bords droits. */
  .hero__image :global(.image__cadre) {
    border-radius: 0;
  }
  .hero__voile {
    position: absolute;
    inset: 0;
    background: linear-gradient(to top, rgb(40 42 56 / 0.62), rgb(40 42 56 / 0.08) 55%);
  }
  .hero__contenu {
    position: relative;
    padding-block: clamp(3rem, 8vw, 6rem);
  }
  .hero__surtitre {
    color: var(--creme);
    font-size: 1rem;
    font-weight: 400;
    line-height: 1.5;
  }
  .hero__titre {
    font-size: var(--t-xxl);
    line-height: 1.05;
    color: var(--creme);
    max-width: 18ch;
    margin: 0 0 1.25rem;
    font-family: var(--police);
    font-weight: 400;
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }
  .hero__sous-titre {
    font-size: var(--t-l);
    margin-bottom: 2.25rem;
  }

  /* Version centrée : titre sur deux lignes, au milieu. */
  .hero--centre {
    align-items: center;
  }
  .hero--centre .hero__contenu {
    text-align: center;
  }
  /* Accueil : ombre ocre floue derrière les trois textes, pour qu'ils se détachent des photos. */
  .hero--centre .hero__surtitre,
  .hero--centre .hero__titre,
  .hero--centre .hero__sous-titre {
    text-shadow:
      0 1px 10px color-mix(in srgb, var(--ocre) 45%, transparent),
      0 0 24px color-mix(in srgb, var(--ocre) 25%, transparent);
  }
  /* Accueil : texte du bouton en ocre. */
  .hero--centre .bouton:not(:hover) {
    color: var(--ocre);
  }
  .hero--centre .hero__titre {
    max-width: none;
    font-size: clamp(2rem, 4.2vw, 4.75rem);
    text-wrap: balance;
  }
</style>
