---
/**
 * Pages L'accompagnement et Trouver votre bien (même arche, étapes propres à chaque page).
 * L'accompagnement : le déroulé d'un projet le long de l'arche du logo (consignes de Caroline, 9 octobre 2026).
 * Les étapes reprennent les phases des devis. Le parcours part du pied de l'arche, en bas à gauche (Écoute),
 * monte le trait vertical, la Modélisation 3D est au sommet de la courbe, puis Plans techniques et Sélection
 * suivent le trait horizontal jusqu'à l'ouverture ; « Les travaux » est après l'ouverture, hors du trait :
 * c'est le passage de main.
 *
 * Ordinateur : grande arche centrée, seuls les titres sont sur l'arche. Un clic sur un point (ou son titre)
 * affiche la description de l'étape à l'intérieur de l'arche ; l'étape 1 est affichée d'emblée.
 * Mobile : la même arche, description et photo comprises, en plus petit.
 */
import {rendreImage} from '../../lib/image'
import type {EtapeArche, PageOffre} from '../../lib/types'

interface Props {
  /** Contenu modifiable dans Sanity (pages L'accompagnement et Trouver votre bien, « Le déroulé en arche »). */
  deroule?: PageOffre['deroule']
  /** Étapes de secours propres à la page (par défaut, celles de L'accompagnement). */
  parDefaut?: {etapes: EtapeArche[]; travaux: EtapeArche}
  /** Surtitre de l'étape placée après l'ouverture de l'arche. */
  surtitreApres?: string
  /** Titre (caché) de la section, lu par les lecteurs d'écran. */
  titreSection?: string
}
const {deroule, parDefaut, surtitreApres = 'Ensuite, je passe la main', titreSection = 'Le déroulé d’un projet'} = Astro.props

// Textes de secours, si Sanity est vide.
const etapesParDefaut: EtapeArche[] = [
  {titre: 'Écoute', texte: 'Comprendre comment vous vivez,\net poser ensemble le cahier des charges.'},
  {titre: 'Aménagement', texte: 'Plans 2D avec plusieurs scénarios\nd’implantation, et planches d’ambiance.'},
  {titre: 'Modélisation 3D', texte: 'Votre futur intérieur en vidéo photoréaliste :\nmatériaux, mobilier, éléments sur mesure.'},
  {titre: 'Plans techniques', texte: 'Plans du mobilier sur mesure et\nimplantations techniques, prêts pour les artisans.'},
  {titre: 'Sélection', texte: 'Les matériaux et, selon votre projet, le mobilier\net les luminaires. Accompagnement en showroom.'},
]
const travauxParDefaut: EtapeArche = {
  titre: 'Les travaux',
  texte:
    'Suivi de chantier par un maître d’œuvre partenaire. Si vous préférez piloter vous-même, je présente le projet aux artisans et je passe en cours de chantier pour les choix décoratifs.',
}
const secours = parDefaut ?? {etapes: etapesParDefaut, travaux: travauxParDefaut}
const etapes = (deroule?.etapes?.length ? deroule.etapes : secours.etapes).slice(0, 5).map((e) => ({titre: e.titre || '', texte: e.texte || '', photo: e.photo}))
const travaux = {titre: deroule?.travaux?.titre || secours.travaux.titre || '', texte: deroule?.travaux?.texte || secours.travaux.texte || '', photo: deroule?.travaux?.photo}

// Arche du logo dans un repère 920 × 440 : trait vertical à gauche, angle arrondi (centre 230, 230 ; rayon 190),
// trait horizontal jusqu'à l'ouverture (720, 40). Les points sont placés en % de ce repère.
const L = 920
const H = 440
// Mobile : même arche, trait vertical plus long (repère 920 × 640) pour loger la description à l'intérieur.
const HM = 640
const DY = HM - H
const sommet = 230 - 190 * Math.SQRT1_2
const points = [
  {x: 40, y: 390, place: 'droite'},
  {x: 40, y: 255, place: 'droite'},
  {x: sommet, y: sommet, place: 'diagonale'},
  {x: 380, y: 40, place: 'dessous'},
  {x: 580, y: 40, place: 'dessous'},
  {x: 810, y: 40, place: 'dessous'},
]
// Photo de chaque étape (choisie dans Sanity), affichée en bas à droite de l'arche.
// Tant qu'une étape n'a pas de photo, l'emplacement reste une forme crème.
const photos = [...etapes, travaux].map((e) => rendreImage(e.photo, {ratio: 3 / 4, maxWidth: 900}))
const toutes = [...etapes.map((e, i) => ({...e, numero: String(i + 1)})), {...travaux, numero: ''}]
// Le point au sommet de la courbe est la 3e étape (Modélisation 3D).
---

<section class="section deroule" aria-labelledby="deroule-titre">
  <div class="conteneur">
    <h2 id="deroule-titre" class="visuellement-cache">{titreSection}</h2>

    <!-- Ordinateur : arche interactive -->
    <div class="parcours" data-arche>
      <div class="parcours__arche">
      <svg class="parcours__trait" viewBox={`0 0 ${L} ${H}`} aria-hidden="true" preserveAspectRatio="none">
        <path d="M40 420 V230 A190 190 0 0 1 230 40 H720" vector-effect="non-scaling-stroke" />
        <!-- Pointillés de l'ouverture jusqu'aux travaux -->
        <path class="parcours__pointilles" d="M720 40 H800" />
      </svg>
      <svg class="parcours__trait parcours__trait--mobile" viewBox={`0 0 ${L} ${HM}`} aria-hidden="true" preserveAspectRatio="none">
        <path d={`M40 ${420 + DY} V230 A190 190 0 0 1 230 40 H720`} vector-effect="non-scaling-stroke" />
        <path class="parcours__pointilles" d="M720 40 H800" vector-effect="non-scaling-stroke" />
      </svg>

      <div class="parcours__etapes" role="tablist" aria-label="Étapes du projet">
        {
          toutes.map((e, i) => (
            <button
              type="button"
              role="tab"
              id={`arche-onglet-${i}`}
              aria-controls={`arche-panneau-${i}`}
              aria-selected={i === 0 ? 'true' : 'false'}
              tabindex={i === 0 ? 0 : -1}
              class:list={['parcours__point', `parcours__point--${points[i].place}`, {'parcours__point--sommet': i === 2, 'parcours__point--travaux': i === 5}]}
              style={`left: ${(points[i].x / L) * 100}%; --y: ${points[i].y / H}; --ym: ${(points[i].y > 230 ? points[i].y + DY : points[i].y) / HM}`}
            >
              {i === 5 ? (
                <svg class="parcours__rond parcours__rond--pointille" viewBox="0 0 20 20" aria-hidden="true">
                  <circle cx="10" cy="10" r="9" pathLength="56" />
                </svg>
              ) : (
                <span class="parcours__rond" aria-hidden="true" />
              )}
              <span class="parcours__libelle">{e.titre}</span>
            </button>
          ))
        }
      </div>
      </div>

      <!-- Photo : son coin bas droit se pose là où se rencontreraient le bas de l'arche et la verticale des travaux -->
      <div class="parcours__photo" aria-hidden="true">
        {
          toutes.map((e, i) => (
            <div class="parcours__photo-etape" data-photo={i} hidden={i !== 0}>
              {photos[i] && (
                <img src={photos[i]!.src} srcset={photos[i]!.srcset} sizes="(min-width: 52rem) 14rem, 50vw" width={photos[i]!.width} height={photos[i]!.height} alt={photos[i]!.alt} loading="lazy" />
              )}
            </div>
          ))
        }
      </div>

      <div class="parcours__panneaux">
        {
          toutes.map((e, i) => (
            <div class="parcours__panneau" role="tabpanel" id={`arche-panneau-${i}`} aria-labelledby={`arche-onglet-${i}`} hidden={i !== 0}>
              <p class="parcours__num">{e.numero ? `Étape ${e.numero}` : surtitreApres}</p>
              <h3>{e.titre}</h3>
              <p class="parcours__texte">{e.texte}</p>
            </div>
          ))
        }
      </div>
    </div>

  </div>
</section>

<script>
  // Un clic sur un point de l'arche affiche son étape ; flèches du clavier pour passer d'une étape à l'autre.
  document.querySelectorAll<HTMLElement>('[data-arche]').forEach((arche) => {
    const onglets = [...arche.querySelectorAll<HTMLButtonElement>('[role="tab"]')]
    const panneaux = [...arche.querySelectorAll<HTMLElement>('[role="tabpanel"]')]
    const choisir = (n: number, focus = false) => {
      onglets.forEach((o, i) => {
        o.setAttribute('aria-selected', String(i === n))
        o.tabIndex = i === n ? 0 : -1
      })
      panneaux.forEach((p, i) => (p.hidden = i !== n))
      arche.querySelectorAll<HTMLElement>('[data-photo]').forEach((p, i) => (p.hidden = i !== n))
      if (focus) onglets[n].focus()
    }
    onglets.forEach((o, i) => {
      o.addEventListener('click', () => choisir(i))
      o.addEventListener('keydown', (e) => {
        const pas = e.key === 'ArrowRight' || e.key === 'ArrowDown' ? 1 : e.key === 'ArrowLeft' || e.key === 'ArrowUp' ? -1 : 0
        if (!pas) return
        e.preventDefault()
        choisir((i + pas + onglets.length) % onglets.length, true)
      })
    })
  })
</script>

<style>
  /* Suit directement l'en-tête de la page, qui a déjà son espace en bas. */
  .deroule {
    padding-top: 0;
  }

  /* L'arche interactive (ordinateur), grande et centrée */
  .parcours {
    position: relative;
    width: min(100%, 69rem);
    aspect-ratio: 920 / 440;
    margin-inline: auto;
  }
  /* Le trait et les points (ordinateur : toute la surface de l'arche). */
  .parcours__arche {
    position: absolute;
    inset: 0;
  }
  .parcours__trait {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    overflow: visible;
  }
  .parcours__trait--mobile {
    display: none;
  }
  .parcours__trait path {
    fill: none;
    stroke: var(--ocre);
    stroke-width: 2;
    stroke-linecap: round;
  }
  .parcours__point {
    position: absolute;
    top: calc(var(--y) * 100%);
    display: flex;
    align-items: center;
    gap: 1rem;
    padding: 0;
    background: none;
    border: 0;
    color: var(--ardoise);
    font: inherit;
    cursor: pointer;
    -webkit-tap-highlight-color: transparent;
    /* Le centre du point tombe sur le trait. */
    transform: translate(-0.5rem, -50%);
  }
  .parcours__point--dessous {
    flex-direction: column;
    gap: 0.9rem;
    transform: translate(-50%, -0.5rem);
  }
  .parcours__point--travaux {
    transform: translate(-50%, -0.625rem);
  }
  .parcours__point--diagonale {
    transform: translate(-0.6rem, -0.6rem);
    align-items: flex-start;
  }
  .parcours__point--diagonale .parcours__libelle {
    margin-top: 1.6rem;
  }
  .parcours__rond {
    flex: none;
    width: 1rem;
    height: 1rem;
    border-radius: 50%;
    border: 2px solid var(--ocre);
    background: var(--creme);
    transition: background 0.25s, transform 0.25s;
  }
  .parcours__point--sommet .parcours__rond {
    width: 1.2rem;
    height: 1.2rem;
  }
  .parcours__libelle {
    font-size: var(--t-xs);
    letter-spacing: 0.18em;
    text-transform: uppercase;
    white-space: nowrap;
    transition: color 0.25s;
  }
  /* Survol et étape affichée : le point se remplit et le titre passe en ocre. */
  .parcours__point:hover .parcours__libelle,
  .parcours__point[aria-selected='true'] .parcours__libelle {
    color: var(--ocre);
  }
  .parcours__point:hover .parcours__rond {
    transform: scale(1.15);
  }
  .parcours__point[aria-selected='true'] .parcours__rond {
    background: var(--ocre);
    transform: scale(1.25);
  }
  /* Pas de contour bleu au clic ; au clavier, un fin contour ocre. */
  .parcours__point:focus {
    outline: none;
  }
  .parcours__point:focus-visible {
    outline: 1px solid var(--ocre);
    outline-offset: 6px;
    border-radius: 4px;
  }
  /* Les travaux : hors du trait, en retrait (ce n'est plus une phase de la prestation). */
  /* Pointillés des travaux : mêmes tirets, bouts arrondis, sur la ligne et sur le rond.
     La ligne part directement du bout de l'arche. */
  .parcours__trait .parcours__pointilles,
  .parcours__rond--pointille circle {
    fill: none;
    stroke: var(--ocre);
    stroke-width: 1.5;
    stroke-linecap: round;
    stroke-dasharray: 3 5;
  }
  /* L'arche est dessinée à environ 1,2 fois son repère : mêmes tirets à l'écran que sur le rond. */
  .parcours__trait .parcours__pointilles {
    stroke-width: 1.25;
    stroke-dasharray: 2.5 4.17;
  }
  .parcours__rond--pointille {
    width: 1.25rem;
    height: 1.25rem;
    border: 0;
    border-radius: 0;
    background: none;
    overflow: visible;
  }
  .parcours__rond--pointille circle {
    transition: fill 0.25s;
  }
  .parcours__point--travaux .parcours__libelle {
    font-style: italic;
    opacity: 0.75;
  }
  .parcours__point--travaux[aria-selected='true'] .parcours__rond {
    background: none;
  }
  .parcours__point--travaux[aria-selected='true'] .parcours__rond--pointille circle {
    fill: color-mix(in srgb, var(--ocre) 35%, transparent);
  }

  /* Description de l'étape, à l'intérieur de l'arche : à gauche de la photo, alignée à droite,
     la dernière ligne au niveau du bas de la photo. */
  .parcours__panneaux {
    position: absolute;
    left: 24%;
    /* Bord gauche de la photo moins un petit écart. */
    right: calc(100% - 870 / 920 * 100% + 20% + 2.5%);
    top: 20%;
    bottom: calc(100% - 420 / 440 * 100%);
    display: flex;
    align-items: flex-end;
    justify-content: flex-end;
    text-align: right;
  }
  /* Photo (rectangle vertical) : coin bas droit au niveau du bas de l'arche (y = 420)
     et un peu à droite des travaux (x = 870), dans le repère 920 × 440. Coins arrondis comme les photos des projets. */
  .parcours__photo {
    position: absolute;
    right: calc(100% - 870 / 920 * 100%);
    bottom: calc(100% - 420 / 440 * 100%);
    width: 20%;
    aspect-ratio: 3 / 4;
    border-radius: var(--arrondi);
    overflow: hidden;
    background: var(--creme-soutenu);
  }
  .parcours__photo-etape,
  .parcours__photo-etape img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .parcours__photo-etape:not([hidden]) {
    animation: apparition 0.4s ease;
  }
  .parcours__panneau {
    max-width: 30rem;
    animation: apparition 0.4s ease;
  }
  .parcours__num {
    font-size: var(--t-xs);
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--ocre);
    margin-bottom: 0.75rem;
  }
  .parcours__panneau h3 {
    font-size: var(--t-l);
    letter-spacing: 0.14em;
    text-transform: uppercase;
    font-weight: 400;
    margin: 0 0 1rem;
  }
  /* Retours à la ligne choisis par Caroline. */
  .parcours__texte {
    white-space: pre-line;
    /* Le bas des lettres (et non l'interligne) tombe au niveau du bas de la photo. */
    margin-bottom: -0.35em !important;
  }
  .parcours__panneau p:last-child {
    font-size: var(--t-m);
    line-height: 1.6;
    margin: 0;
  }
  @keyframes apparition {
    from {
      opacity: 0;
      transform: translateY(6px);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .parcours__panneau {
      animation: none;
    }
  }

  /* Mobile : la même arche, avec la description et la photo à l'intérieur, simplement en plus petit.
     Les titres du trait du haut passent sur deux lignes pour ne pas se toucher. */
  @media (max-width: 51.99rem) {
    .parcours {
      aspect-ratio: 920 / 640;
    }
    .parcours__trait {
      display: none;
    }
    .parcours__trait--mobile {
      display: block;
    }
    .parcours__trait--mobile .parcours__pointilles {
      stroke-width: 1.25;
      stroke-dasharray: 2 3.5;
    }
    .parcours__point {
      top: calc(var(--ym) * 100%);
      gap: 0.5rem;
      transform: translate(-0.35rem, -50%);
    }
    .parcours__point--dessous {
      gap: 0.5rem;
      transform: translate(-50%, -0.35rem);
    }
    .parcours__point--travaux {
      transform: translate(-50%, -0.45rem);
    }
    .parcours__point--diagonale {
      transform: translate(-0.4rem, -0.4rem);
    }
    .parcours__point--diagonale .parcours__libelle {
      margin-top: 1.9rem;
    }
    .parcours__rond {
      width: 0.7rem;
      height: 0.7rem;
      border-width: 1.5px;
    }
    .parcours__point--sommet .parcours__rond {
      width: 0.8rem;
      height: 0.8rem;
    }
    .parcours__rond--pointille {
      width: 0.9rem;
      height: 0.9rem;
    }
    .parcours__libelle {
      font-size: 0.5625rem;
      letter-spacing: 0.08em;
      line-height: 1.35;
    }
    /* Titres des étapes sur deux lignes si besoin, pour qu'ils ne touchent ni leurs voisins ni la description. */
    .parcours__libelle {
      max-width: 4.25rem;
      white-space: normal;
      text-align: left;
    }
    .parcours__point--dessous .parcours__libelle {
      text-align: center;
    }
    /* Description dans l'arche, en petit, entre les titres de gauche et la photo. */
    .parcours__panneaux {
      left: 33%;
      top: calc(175 / 640 * 100%);
      bottom: calc(20 / 640 * 100%);
    }
    /* Photo un peu plus grande (plus haute et un peu plus large), même arche. */
    .parcours__photo {
      bottom: calc(20 / 640 * 100%);
      width: 22%;
      aspect-ratio: 2 / 3;
    }
    .parcours__panneaux {
      right: calc(100% - 870 / 920 * 100% + 22% + 2.5%);
    }
    .parcours__panneau {
      max-width: none;
    }
    /* « Étape 1 » et le titre de l'étape, plus grands eux aussi, pour aller avec les explications. */
    .parcours__num {
      font-size: 0.625rem;
      letter-spacing: 0.14em;
      margin-bottom: 0.25rem;
      /* S'il passe sur deux lignes, il reste à l'écart du titre « Modélisation 3D » de l'arche. */
      padding-left: 15%;
    }
    .parcours__panneau h3 {
      font-size: clamp(0.75rem, 3.4vw, 0.875rem);
      letter-spacing: 0.12em;
      margin-bottom: 0.3rem;
    }
    .parcours__texte {
      white-space: normal;
    }
    .parcours__panneau p:last-child {
      /* Explications lisibles sur téléphone (environ 10,5 px sur un iPhone, au lieu de 9 px),
         dans la même arche : interligne resserré pour tenir sous les titres. */
      font-size: clamp(0.625rem, 2.8vw, 0.75rem);
      line-height: 1.3;
    }
  }
</style>
