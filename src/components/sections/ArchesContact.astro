---
/**
 * Page Contact : les trois portes d'entrée, chacune dans une arche basse, empilées l'une sous l'autre.
 * Même tracé que l'arche du logo et du déroulé (L'accompagnement, Trouver votre bien) : trait vertical à gauche,
 * angle arrondi, trait horizontal jusqu'au bord droit ; pas d'étapes, juste un titre, une phrase et le bouton
 * vers le bon formulaire Tally. Les trois au même niveau, pour que le choix soit clair.
 * Les deux premières reprennent les textes de l'accueil (« Deux points de départ »), la troisième est propre à Contact.
 */
import {FORMULAIRES} from '../../lib/formulaires'
import type {PageAccueil, PageContact} from '../../lib/types'

interface Props {
  aiguillage?: PageAccueil['aiguillage']
  pro?: PageContact['pro']
}
const {aiguillage, pro} = Astro.props
const arches = [
  {titre: aiguillage?.colonne1?.titre, texte: aiguillage?.colonne1?.texte, bouton: aiguillage?.colonne1?.boutonLibelle || 'Parlons de votre projet', href: FORMULAIRES.projet},
  {titre: aiguillage?.colonne2?.titre, texte: aiguillage?.colonne2?.texte, bouton: aiguillage?.colonne2?.boutonLibelle || 'Trouver votre bien', href: FORMULAIRES.trouver},
  {
    titre: pro?.titre || 'Vous êtes un professionnel.',
    texte: pro?.texte || 'Restaurant, bar, boutique ou bureau : un lieu à votre image.',
    bouton: pro?.boutonLibelle || 'Parlons de vos locaux',
    href: FORMULAIRES.professionnel,
  },
].filter((a) => a.titre)
---

<div class="arches" data-arches>
  {
    arches.map((a, i) => (
      <div class="arche-contact" style={`--rang: ${i}`}>
        <h3>{a.titre}</h3>
        {a.texte && <p>{a.texte}</p>}
        <a class="bouton arche-contact__bouton" href={a.href}>
          {a.bouton}
        </a>
      </div>
    ))
  }
</div>

<script>
  // Les arches apparaissent l'une après l'autre quand on arrive dessus en faisant défiler la page.
  document.querySelectorAll<HTMLElement>('[data-arches]').forEach((bloc) => {
    if (!('IntersectionObserver' in window) || matchMedia('(prefers-reduced-motion: reduce)').matches) return
    const arches = [...bloc.querySelectorAll<HTMLElement>('.arche-contact')]
    bloc.classList.add('arches--animees')
    const obs = new IntersectionObserver(
      (entrees) =>
        entrees.forEach((e) => {
          if (!e.isIntersecting) return
          ;(e.target as HTMLElement).classList.add('est-visible')
          obs.unobserve(e.target)
        }),
      {threshold: 0.25},
    )
    arches.forEach((a) => obs.observe(a))
  })
</script>

<style>
  .arches {
    display: grid;
    gap: clamp(3.5rem, 7vw, 5rem);
    margin-top: clamp(1.5rem, 3vw, 2.5rem);
  }
  /* Apparition au défilement : l'arche monte légèrement en se dévoilant. Sans JavaScript, tout reste visible. */
  .arches--animees .arche-contact {
    opacity: 0;
    transform: translateY(1.5rem);
    transition: opacity 0.8s ease, transform 0.8s ease;
    /* Quand plusieurs arches entrent en même temps, elles apparaissent l'une après l'autre. */
    transition-delay: calc(var(--rang) * 0.15s);
  }
  .arches--animees .arche-contact.est-visible {
    opacity: 1;
    transform: none;
  }
  /* Boutons en ocre, tous de la même largeur, un peu plus petits que les boutons habituels. */
  .arche-contact__bouton {
    justify-content: center;
    width: 15rem;
    max-width: 100%;
    padding: 0.85em 1.25em;
    font-size: 0.75rem;
    background: var(--ocre);
    border-color: var(--ocre);
    color: var(--blanc);
  }
  .arche-contact__bouton:hover {
    background: transparent;
    color: var(--ocre);
  }
  /* L'arche : trait vertical à gauche, angle arrondi, trait horizontal jusqu'au bord droit (pas de bas ni de côté droit). */
  .arche-contact {
    --rayon-arche: clamp(3rem, 6vw, 4.5rem);
    border: 2px solid var(--ocre);
    border-right: 0;
    border-bottom: 0;
    border-top-left-radius: var(--rayon-arche);
    padding: 2rem 0.75rem 0.5rem 1.5rem;
    display: grid;
    gap: 1rem;
    justify-items: center;
    text-align: center;
  }
  .arche-contact h3 {
    margin: 0;
    font-size: clamp(1.2rem, 0.9rem + 0.6vw, 1.45rem);
    letter-spacing: 0.14em;
    text-transform: uppercase;
    font-weight: 400;
    white-space: pre-line;
  }
  .arche-contact p {
    margin: 0;
    font-size: var(--t-m);
    line-height: 1.6;
    max-width: 26rem;
  }
  /* Ordinateur : arche basse, titre à gauche, phrase au milieu, bouton à droite, sur une seule rangée. */
  @media (min-width: 52rem) {
    .arche-contact {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1.25fr) 17rem;
      align-items: center;
      justify-items: start;
      gap: clamp(1.5rem, 3vw, 3rem);
      text-align: left;
      min-height: 9rem;
      padding: clamp(2rem, 4vw, 2.75rem) clamp(1.25rem, 3vw, 2rem) 0 calc(var(--rayon-arche) + 0.5rem);
    }
    .arche-contact__bouton {
      justify-self: end;
      white-space: nowrap;
    }
  }
</style>
