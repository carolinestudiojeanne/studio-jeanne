---
/** S7 : avis clients, même présentation en cartes que la page Avis clients (voir MurAvis). */
import MurAvis from './MurAvis.astro'
import type {Avis} from '../../lib/types'

interface Props {
  avis: Array<Pick<Avis, 'texte' | 'prenom'> & Partial<Pick<Avis, '_id' | 'note' | 'date'>>>
  colonnes?: boolean
}
const {avis, colonnes = true} = Astro.props
---

<MurAvis avis={avis} colonnes={colonnes ? 3 : 1} />
