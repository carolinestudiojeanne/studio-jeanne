---
/**
 * Carrousel de l'accueil, sur toute la largeur : un grand projet au centre, jusqu'à deux voisins
 * plus petits de chaque côté, flèches sur les côtés pour défiler (en boucle).
 * Sur tablette, un seul voisin de chaque côté ; sur mobile, seul le projet du centre.
 */
import Image from '../Image.astro'
import type {ProjetCarte} from '../../lib/types'
import {placeCarrousel} from '../../lib/carrousel'

interface Props {
  projets: ProjetCarte[]
}
const {projets} = Astro.props
const n = projets.length
// Position de départ (sans JavaScript) : premier projet au centre.
const place = (i: number, centre: number) => placeCarrousel(i, centre, n)
---

<div class="carrousel" data-carrousel>
  {
    Astro.slots.has('default') && (
      <div class="carrousel__entete">
        <slot />
      </div>
    )
  }
  {
    Astro.slots.has('lien') && (
      <div class="carrousel__lien-tous" data-lien-tous>
        <slot name="lien" />
      </div>
    )
  }
  {
    n > 1 && (
      <button type="button" class="carrousel__fleche" data-sens="-1" aria-label="Projet précédent">
        <svg viewBox="0 0 9 16" aria-hidden="true"><path d="M8 1 1 8l7 7" /></svg>
      </button>
    )
  }
  <ul class="carrousel__piste" aria-live="polite">
    {
      projets.map((p, i) => (
        <li class="carrousel__item" data-place={place(i, 0)} aria-hidden={i === 0 ? undefined : 'true'}>
          <a href={`/projets/${p.slug}`} class="carrousel__lien" tabindex={i === 0 ? undefined : '-1'}>
            <Image image={p.imagePrincipale} ratio={4 / 5} legende={false} sizes="(min-width: 52rem) 30vw, 90vw" />
            <span class="carrousel__titre">{p.titre}</span>
            {p.commune && <span class="carrousel__lieu">{p.commune}</span>}
          </a>
        </li>
      ))
    }
  </ul>
  {
    n > 1 && (
      <button type="button" class="carrousel__fleche" data-sens="1" aria-label="Projet suivant">
        <svg viewBox="0 0 9 16" aria-hidden="true"><path d="M1 1l7 7-7 7" /></svg>
      </button>
    )
  }
</div>

<script>
  import {placeCarrousel} from '../../lib/carrousel'

  document.querySelectorAll<HTMLElement>('[data-carrousel]').forEach((carrousel) => {
    const items = [...carrousel.querySelectorAll<HTMLElement>('.carrousel__item')]
    const n = items.length
    let centre = 0
    const afficher = () => {
      items.forEach((item, i) => {
        const place = placeCarrousel(i, centre, n)
        if (place) item.dataset.place = place
        else delete item.dataset.place
        const auCentre = place === 'centre'
        if (auCentre) item.removeAttribute('aria-hidden')
        else item.setAttribute('aria-hidden', 'true')
        item.querySelector('a')?.setAttribute('tabindex', auCentre ? '0' : '-1')
      })
    }
    // Lien « voir tous les projets » : aligné à droite sur la dernière photo, à mi-hauteur entre
    // le haut de la 2e et de la 3e photo en partant de la droite (sur tablette, 3 photos : 1re et 2e).
    const lien = carrousel.querySelector<HTMLElement>('[data-lien-tous]')
    const placerLien = () => {
      if (!lien) return
      lien.style.removeProperty('top')
      lien.style.removeProperty('right')
      lien.removeAttribute('data-place')
      const visibles = items
        .filter((item) => item.offsetParent)
        .map((item) => item.querySelector('.image__cadre')!.getBoundingClientRect())
        .sort((a, b) => b.right - a.right)
      if (visibles.length < 2) return
      const [derniere, avantDerniere] = visibles.length >= 5 ? visibles.slice(1, 3) : visibles
      const cadre = carrousel.getBoundingClientRect()
      const milieu = (derniere.top + avantDerniere.top) / 2 - cadre.top
      lien.dataset.place = ''
      lien.style.top = `${milieu - lien.offsetHeight / 2}px`
      lien.style.right = `${cadre.right - visibles[0].right}px`
    }
    placerLien()
    window.addEventListener('resize', placerLien)
    document.fonts?.ready.then(placerLien)

    carrousel.querySelectorAll<HTMLButtonElement>('.carrousel__fleche').forEach((bouton) => {
      bouton.addEventListener('click', () => {
        centre = (centre + Number(bouton.dataset.sens) + n) % n
        afficher()
        placerLien()
      })
    })
  })
</script>

<style>
  /* Grille : flèche | photos | flèche. L'en-tête (titre, texte, lien) s'aligne sur les photos. */
  .carrousel {
    position: relative;
    display: grid;
    grid-template-columns: auto minmax(0, 1fr) auto;
    align-items: center;
    column-gap: clamp(0.25rem, 1.5vw, 1.25rem);
    padding-inline: clamp(0.25rem, 1.5vw, 1.25rem);
  }
  .carrousel__lien-tous {
    grid-column: 2;
    grid-row: 1;
    justify-self: end;
    align-self: end;
  }
  /* Placé par le script entre le haut des deux dernières photos. */
  .carrousel__lien-tous[data-place] {
    position: absolute;
  }
  .carrousel__lien-tous[data-place] > :global(*) {
    margin: 0;
  }
  .carrousel__entete {
    grid-column: 2;
    grid-row: 1;
  }
  .carrousel__fleche,
  .carrousel__piste {
    grid-row: 2;
  }
  .carrousel__piste {
    grid-column: 2;
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: 1fr;
    /* Photos collées les unes aux autres, alignées sur leur milieu. */
    align-items: center;
    gap: 0;
  }
  .carrousel__item {
    display: none;
    grid-row: 1;
  }
  .carrousel__item[data-place='centre'] {
    display: block;
    grid-column: 1;
    animation: apparition 0.5s ease;
  }
  .carrousel__lien {
    display: block;
    text-decoration: none;
    color: inherit;
    text-align: center;
  }
  .carrousel__titre,
  .carrousel__lieu {
    padding-inline: 0.5rem;
  }
  .carrousel__titre {
    display: block;
    margin-top: 1.1rem;
    font-size: var(--t-m);
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--ardoise);
  }
  /* Lieu : même format que sur la page Projets (majuscules, lettres espacées, ocre). */
  .carrousel__lieu {
    display: block;
    margin-top: 0.35rem;
    font-size: var(--t-xs);
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--ocre);
  }

  /* Tablette : un voisin de chaque côté. */
  @media (min-width: 52rem) {
    .carrousel__piste {
      grid-template-columns: 1.4fr 2fr 1.4fr;
    }
    .carrousel__item[data-place='g1'],
    .carrousel__item[data-place='d1'] {
      display: block;
      animation: apparition 0.5s ease;
    }
    .carrousel__item[data-place='g1'] {
      grid-column: 1;
    }
    .carrousel__item[data-place='centre'] {
      grid-column: 2;
    }
    .carrousel__item[data-place='d1'] {
      grid-column: 3;
    }
    .carrousel__item:not([data-place='centre']) .carrousel__titre {
      font-size: var(--t-s);
    }
  }

  /* Grand écran : deux voisins de chaque côté. */
  @media (min-width: 75rem) {
    .carrousel__piste {
      grid-template-columns: 1fr 1.4fr 2fr 1.4fr 1fr;
    }
    .carrousel__item[data-place='g2'],
    .carrousel__item[data-place='d2'] {
      display: block;
      animation: apparition 0.5s ease;
    }
    .carrousel__item[data-place='g2'] {
      grid-column: 1;
    }
    .carrousel__item[data-place='g1'] {
      grid-column: 2;
    }
    .carrousel__item[data-place='centre'] {
      grid-column: 3;
    }
    .carrousel__item[data-place='d1'] {
      grid-column: 4;
    }
    .carrousel__item[data-place='d2'] {
      grid-column: 5;
    }
  }

  .carrousel__fleche {
    flex: none;
    background: none;
    border: 0;
    padding: 1rem 0.5rem;
    color: var(--ocre);
    line-height: 0;
    cursor: pointer;
    transition: transform 0.25s;
  }
  /* Simple tête de flèche fine, en ocre (comme les liens « Découvrir… »). */
  .carrousel__fleche svg {
    width: clamp(0.5rem, 0.65vw, 0.65rem);
    height: auto;
    fill: none;
    stroke: currentColor;
    stroke-width: 1;
    overflow: visible;
  }
  .carrousel__fleche[data-sens='-1']:hover {
    transform: translateX(-4px);
  }
  .carrousel__fleche[data-sens='1']:hover {
    transform: translateX(4px);
  }

  @keyframes apparition {
    from {
      opacity: 0;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .carrousel__item[data-place] {
      animation: none;
    }
  }
</style>
