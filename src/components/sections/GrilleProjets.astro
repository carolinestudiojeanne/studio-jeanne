---
/** S4 : grille de cartes projet (image + titre + lieu). */
import CarteProjet from './CarteProjet.astro'
import type {ProjetCarte} from '../../lib/types'

interface Props {
  projets: ProjetCarte[]
  colonnes?: 2 | 3 | 4
  titreCartes?: 'h2' | 'h3'
}
const {projets, colonnes = 3, titreCartes = 'h3'} = Astro.props
---

{
  projets.length > 0 && (
    <ul class:list={['grille', `grille--${colonnes}`]}>
      {projets.map((p) => (
        <li data-categorie={p.categorie}>
          <CarteProjet projet={p} titre={titreCartes} />
        </li>
      ))}
    </ul>
  )
}

<style>
  .grille {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: clamp(2.5rem, 5vw, 4rem) clamp(1.25rem, 3vw, 2.5rem);
    grid-template-columns: 1fr;
  }
  @media (min-width: 40rem) {
    .grille {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  @media (min-width: 64rem) {
    .grille--3 {
      grid-template-columns: repeat(3, 1fr);
    }
    .grille--4 {
      grid-template-columns: repeat(4, 1fr);
    }
    /* Cartes plus étroites : titre plus petit, lieu sous le titre. */
    .grille--4 :global(.carte__texte) {
      flex-direction: column;
      gap: 0.35rem;
    }
    .grille--4 :global(.carte__titre) {
      font-size: var(--t-m);
    }
  }
</style>
