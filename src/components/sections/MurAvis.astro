---
/**
 * Mur d'avis : une mosaïque de cartes sur 3 colonnes (2 sur tablette, 1 sur mobile).
 * Chaque carte : étoiles, texte, prénom et date. Les cartes s'emboîtent selon la longueur du texte.
 * Même présentation partout où des avis apparaissent (accueil, page Avis clients, pages projet).
 */
import type {Avis} from '../../lib/types'

interface Props {
  avis: Array<Pick<Avis, 'texte' | 'prenom'> & Partial<Pick<Avis, '_id' | 'note' | 'date'>>>
  /** Nombre de colonnes au maximum (1 pour un avis seul). */
  colonnes?: 1 | 2 | 3
  /** Cartes toutes de la même taille, texte coupé au-delà de quelques lignes (accueil). */
  egales?: boolean
}
const {avis, colonnes = 3, egales = false} = Astro.props

const moisAnnee = (date?: string) =>
  date ? new Date(date).toLocaleDateString('fr-FR', {month: 'long', year: 'numeric'}) : ''
---

{
  avis.length > 0 && (
    <ul class:list={['mur', `mur--${colonnes}`, {'mur--egales': egales}]} data-mur={!egales && colonnes > 1 ? '' : undefined}>
      {avis.map((a) => (
        <li class="mur__carte">
          <figure>
            {a.note ? (
              <p class="mur__etoiles" aria-label={`${a.note} étoiles sur 5`}>
                {'★'.repeat(a.note)}
              </p>
            ) : null}
            <blockquote>
              <p>{a.texte}</p>
            </blockquote>
            <figcaption>
              <span class="mur__prenom">{a.prenom}</span>
              {a.date && <span class="mur__date">{moisAnnee(a.date)}</span>}
            </figcaption>
          </figure>
        </li>
      ))}
    </ul>
  )
}

<script>
  // Mur d'avis : les cartes sont réparties colonne par colonne, de gauche à droite
  // (1re carte en haut à gauche, 2e en haut au milieu…), pour lire les avis du plus récent
  // au plus ancien ligne par ligne. Sans JavaScript, la mosaïque en colonnes CSS reste en place.
  document.querySelectorAll<HTMLUListElement>('[data-mur]').forEach((mur) => {
    const cartes = [...mur.querySelectorAll<HTMLLIElement>(':scope > li')]
    const max = mur.classList.contains('mur--2') ? 2 : 3
    let actuel = 0
    const repartir = () => {
      const n = Math.min(max, matchMedia('(min-width: 64rem)').matches ? 3 : matchMedia('(min-width: 40rem)').matches ? 2 : 1)
      if (n === actuel) return
      actuel = n
      mur.querySelectorAll('.mur__colonne').forEach((c) => c.remove())
      mur.classList.toggle('mur--reparti', n > 1)
      if (n === 1) {
        cartes.forEach((c) => mur.append(c))
        return
      }
      const colonnes = Array.from({length: n}, () => {
        const li = document.createElement('li')
        li.className = 'mur__colonne'
        const ul = document.createElement('ul')
        li.append(ul)
        mur.append(li)
        return ul
      })
      cartes.forEach((c, i) => colonnes[i % n].append(c))
    }
    repartir()
    addEventListener('resize', repartir)
  })
</script>

<style>
  /* Répartition par le script : des colonnes côte à côte. */
  .mur--reparti {
    columns: auto;
    display: flex;
    align-items: flex-start;
    gap: clamp(1rem, 2vw, 1.5rem);
  }
  .mur--reparti > :global(.mur__colonne) {
    flex: 1;
    min-width: 0;
  }
  .mur--reparti :global(.mur__colonne > ul) {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .mur {
    list-style: none;
    margin: 0;
    padding: 0;
    columns: 1;
    column-gap: clamp(1rem, 2vw, 1.5rem);
  }
  @media (min-width: 40rem) {
    .mur--2,
    .mur--3 {
      columns: 2;
    }
  }
  @media (min-width: 64rem) {
    .mur--3 {
      columns: 3;
    }
  }
  /* Cartes de même taille (accueil) : grille, même hauteur, texte limité à 8 lignes. */
  .mur--egales {
    columns: auto;
    display: grid;
    gap: clamp(1rem, 2vw, 1.5rem);
  }
  @media (min-width: 52rem) {
    .mur--egales {
      grid-template-columns: repeat(3, 1fr);
    }
  }
  .mur--egales .mur__carte {
    margin: 0;
    display: flex;
  }
  .mur--egales figure {
    display: flex;
    flex-direction: column;
    width: 100%;
  }
  .mur--egales blockquote {
    flex: 1;
  }
  .mur--egales blockquote p {
    display: -webkit-box;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 8;
    line-clamp: 8;
    overflow: hidden;
    /* Hauteur fixe de 8 lignes : toutes les cartes ont exactement la même taille. */
    height: calc(8 * 1.65em);
  }

  /* Avis seul : carte centrée, de largeur de lecture. */
  .mur--1 {
    max-width: 40rem;
    margin-inline: auto;
  }
  .mur__carte {
    break-inside: avoid;
    margin-bottom: clamp(1rem, 2vw, 1.5rem);
    padding: clamp(1.5rem, 2.5vw, 2rem);
    background: var(--blanc);
    border-radius: var(--arrondi);
    border: 1px solid color-mix(in srgb, var(--ardoise) 8%, transparent);
  }
  .mur__carte figure {
    margin: 0;
  }
  .mur__etoiles {
    margin: 0 0 1rem;
    color: var(--ocre);
    letter-spacing: 0.2em;
    font-size: var(--t-s);
  }
  .mur__carte blockquote {
    margin: 0;
  }
  .mur__carte blockquote p {
    margin: 0;
    font-size: var(--t-s);
    line-height: 1.65;
    white-space: pre-line;
  }
  .mur__carte figcaption {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 0.25rem 1rem;
    margin-top: 1.25rem;
    padding-top: 1rem;
    border-top: 1px solid color-mix(in srgb, var(--ocre) 35%, transparent);
    font-size: var(--t-xs);
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }
  .mur__prenom {
    color: var(--ardoise);
  }
  .mur__date {
    opacity: 0.75;
  }
</style>
