---
/**
 * S5 : appel à l'action en fin de page, au format bande beige minimaliste (comme « La première étape » sur l'accueil) :
 * « TITRE : LIEN VERS LE FORMULAIRE », puis la phrase en italique dessous. Le lien mène au formulaire de la page, sinon à /contact.
 */
import Bande from './Bande.astro'
import type {AppelAction} from '../../lib/types'

interface Props {
  appel?: AppelAction
  /** Ancien lien secondaire : plus affiché (toute la bande est déjà un lien). */
  lien?: {libelle: string; href: string}
  /** Adresse du lien : le formulaire Tally de la page (par défaut, la page Contact). */
  href?: string
}
const {appel, href = '/contact'} = Astro.props
---

{
  appel?.titre && (
    <div class="appel">
      <Bande texte={appel.titre} lien={appel.boutonLibelle || 'Remplir le formulaire'} href={href} description={appel.texte?.replaceAll('\n', ' ')} deuxPoints />
    </div>
  )
}

<style>
  /* Filet fin quand la bande suit directement une autre bande beige (pages projet). */
  .appel {
    border-top: 1px solid color-mix(in srgb, var(--ardoise) 12%, transparent);
  }
</style>
