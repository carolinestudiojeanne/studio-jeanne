---
/** Bloc questions fréquentes (balisé FAQPage par la page). */
import type {QuestionReponse} from '../../lib/types'

interface Props {
  faq?: QuestionReponse[]
  titre?: string
  /** Fond crème soutenu (par défaut) ou fond de page. */
  soutenu?: boolean
}
const {faq = [], titre = 'Questions fréquentes', soutenu = true} = Astro.props
---

{
  faq.length > 0 && (
    <section class:list={['section', {'fond-soutenu': soutenu}]}>
      <div class="conteneur">
        <h2>{titre}</h2>
        <div class="faq">
          {faq.map((q) => (
            <details class="faq__item" name="faq">
              <summary>{q.question}</summary>
              <p>{q.reponse}</p>
            </details>
          ))}
        </div>
      </div>
    </section>
  )
}

<script>
  // Une seule question ouverte à la fois, et un clic ailleurs sur la page referme la question ouverte.
  const questions = [...document.querySelectorAll<HTMLDetailsElement>('.faq__item')]
  questions.forEach((q) =>
    q.addEventListener('toggle', () => {
      if (q.open) questions.forEach((autre) => autre !== q && (autre.open = false))
    }),
  )
  document.addEventListener('click', (e) => {
    if (!(e.target as Element).closest('.faq__item')) questions.forEach((q) => (q.open = false))
  })
</script>

<style>
  /* Pleine largeur du site, questions serrées, en capitales espacées comme le menu du haut. */
  .faq {
    border-top: 1px solid color-mix(in srgb, var(--ardoise) 25%, transparent);
  }
  .faq__item {
    border-bottom: 1px solid color-mix(in srgb, var(--ardoise) 25%, transparent);
  }
  .faq__item summary {
    cursor: pointer;
    list-style: none;
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1.5rem;
    padding: 0.85rem 0;
    color: var(--ardoise);
    font-size: var(--t-xs);
    letter-spacing: 0.18em;
    text-transform: uppercase;
  }
  .faq__item summary::-webkit-details-marker {
    display: none;
  }
  .faq__item summary::after {
    content: '+';
    font-size: 1.25rem;
    line-height: 1;
    letter-spacing: 0;
    color: var(--ocre);
    transition: transform 0.3s;
  }
  .faq__item[open] summary::after {
    transform: rotate(45deg);
  }
  .faq__item p {
    max-width: none;
    padding-bottom: 1rem;
    margin: 0;
  }
</style>
