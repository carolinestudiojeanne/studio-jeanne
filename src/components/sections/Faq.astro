---
/** Bloc questions fréquentes (balisé FAQPage par la page). */
import type {QuestionReponse} from '../../lib/types'

interface Props {
  faq?: QuestionReponse[]
  titre?: string
  /** Fond crème soutenu (par défaut) ou fond de page. */
  soutenu?: boolean
  /** Fond blanc (page Contact). */
  blanc?: boolean
}
const {faq = [], titre = 'Questions fréquentes', soutenu = true, blanc = false} = Astro.props
---

{
  faq.length > 0 && (
    <section class:list={['section', {'fond-soutenu': soutenu && !blanc, 'faq--blanc': blanc}]}>
      <div class="conteneur">
        <h2>{titre}</h2>
        <div class="faq">
          {faq.map((q) => (
            <details class="faq__item" name="faq">
              <summary>
                {q.question}
                <svg class="faq__fleche" viewBox="0 0 16 9" aria-hidden="true"><path d="M1 1l7 7 7-7" /></svg>
              </summary>
              <p>{q.reponse}</p>
            </details>
          ))}
        </div>
      </div>
    </section>
  )
}

<script>
  // Une seule question ouverte à la fois, et un clic ailleurs sur la page referme la question ouverte.
  const questions = [...document.querySelectorAll<HTMLDetailsElement>('.faq__item')]
  questions.forEach((q) =>
    q.addEventListener('toggle', () => {
      if (q.open) questions.forEach((autre) => autre !== q && (autre.open = false))
    }),
  )
  document.addEventListener('click', (e) => {
    if (!(e.target as Element).closest('.faq__item')) questions.forEach((q) => (q.open = false))
  })
</script>

<style>
  .faq--blanc {
    background: var(--blanc);
  }
  /* Pleine largeur du site, questions serrées, en ocre, au format des titres du site (en plus petit). */
  .faq {
    border-top: 1px solid color-mix(in srgb, var(--ardoise) 25%, transparent);
  }
  .faq__item {
    border-bottom: 1px solid color-mix(in srgb, var(--ardoise) 25%, transparent);
  }
  .faq__item summary {
    cursor: pointer;
    list-style: none;
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1.5rem;
    padding: 0.85rem 0;
    color: var(--ocre);
    font-size: 1rem;
    line-height: 1.4;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }
  .faq__item summary::-webkit-details-marker {
    display: none;
  }
  /* Tête de flèche fine (même trait que les flèches du carrousel), pointe vers le bas, se retourne à l'ouverture. */
  .faq__fleche {
    flex: none;
    width: 0.9rem;
    height: auto;
    fill: none;
    stroke: var(--ocre);
    stroke-width: 1;
    overflow: visible;
    transition: transform 0.3s;
  }
  .faq__item[open] .faq__fleche {
    transform: rotate(180deg);
  }
  .faq__item p {
    max-width: none;
    padding-bottom: 1rem;
    margin: 0;
  }
</style>
