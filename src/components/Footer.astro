---
import Logo from './Logo.astro'
import {MENU} from '../lib/navigation'
import type {Reglages} from '../lib/types'

interface Props {
  reglages: Reglages
  analytics: boolean
}
const {reglages: r, analytics} = Astro.props
const tel = r.telephone?.replace(/\s/g, '')
const annee = new Date().getFullYear()
---

<footer class="pied fond-ardoise">
  <div class="conteneur pied__haut">
    <a href="/" class="pied__marque" aria-label="Studio Jeanne, retour à l’accueil"><Logo clair class="pied__logo" /></a>

    <nav class="pied__nav" aria-label="Pages du site">
      <ul>
        {MENU.map((i) => <li><a href={i.href}>{i.libelle}</a></li>)}
        <li><a href="/professionnels">Professionnels</a></li>
        <li><a href="/avis-clients">Avis clients</a></li>
      </ul>
    </nav>

    <ul class="pied__contact">
      {tel && <li><a href={`tel:${tel}`}>{r.telephone}</a></li>}
      {r.email && <li><a href={`mailto:${r.email}`}>{r.email}</a></li>}
      {r.instagram && <li><a href={r.instagram} target="_blank" rel="noopener">Instagram</a></li>}
      {r.linkedin && <li><a href={r.linkedin} target="_blank" rel="noopener">LinkedIn</a></li>}
    </ul>
  </div>

  <div class="conteneur pied__bas">
    <span>
      © {annee} Studio Jeanne{r.afficherAdresse && r.adresse ? ` · ${r.adresse}, ${r.codePostal} ${r.ville}` : ''}{r.zone ? ` · ${r.zone}` : ''}
    </span>
    <ul>
      <li><a href="/mentions-legales">Mentions légales</a></li>
      <li><a href="/politique-de-confidentialite">Politique de confidentialité</a></li>
      <li><a href="/cgv">CGV</a></li>
      {analytics && <li><button type="button" class="pied__cookies" data-gerer-cookies>Gérer les cookies</button></li>}
    </ul>
  </div>
</footer>

<style>
  /* Pied de page fin : une ligne (logo, menu, contact) puis une ligne de mentions. */
  .pied {
    padding-block: clamp(1.5rem, 3vw, 2.25rem) 1.25rem;
    font-size: var(--t-xs);
    letter-spacing: 0.06em;
  }
  .pied a {
    text-decoration: none;
  }
  .pied a:hover {
    text-decoration: underline;
    text-decoration-color: var(--ocre);
  }
  .pied ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem 1.5rem;
  }
  .pied__haut {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1.25rem 2.5rem;
  }
  .pied__marque :global(.pied__logo) {
    width: 4.5rem;
  }
  .pied__nav ul {
    text-transform: uppercase;
    letter-spacing: 0.14em;
  }
  .pied__bas {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 0.5rem 2rem;
    margin-top: 1.25rem;
    padding-top: 1rem;
    border-top: 1px solid color-mix(in srgb, var(--creme) 25%, transparent);
    opacity: 0.85;
  }
  .pied__cookies {
    background: none;
    border: 0;
    padding: 0;
    color: inherit;
    font: inherit;
    letter-spacing: inherit;
    cursor: pointer;
  }
  .pied__cookies:hover {
    text-decoration: underline;
  }
</style>
