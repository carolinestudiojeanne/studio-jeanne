---
import Logo from './Logo.astro'
import type {Reglages} from '../lib/types'

interface Props {
  reglages: Reglages
  analytics: boolean
}
const {reglages: r, analytics} = Astro.props
const tel = r.telephone?.replace(/\s/g, '')
---

<footer class="pied fond-ardoise">
  <div class="conteneur pied__haut">
    <a href="/" class="pied__marque" aria-label="Studio Jeanne, retour à l’accueil"><Logo clair class="pied__logo" /></a>

    <ul class="pied__contact">
      {tel && <li><a href={`tel:${tel}`}>{r.telephone}</a></li>}
      {r.email && <li><a href={`mailto:${r.email}`}>{r.email}</a></li>}
      {
        r.instagram && (
          <li>
            <a class="pied__reseau" href={r.instagram} target="_blank" rel="noopener" aria-label="Instagram">
              <svg viewBox="0 0 24 24" aria-hidden="true">
                <rect x="3.5" y="3.5" width="17" height="17" rx="5" />
                <circle cx="12" cy="12" r="4" />
                <circle cx="17.2" cy="6.8" r="0.6" class="plein" />
              </svg>
            </a>
          </li>
        )
      }
      {
        r.linkedin && (
          <li>
            <a class="pied__reseau" href={r.linkedin} target="_blank" rel="noopener" aria-label="LinkedIn">
              <svg viewBox="0 0 24 24" aria-hidden="true">
                <rect x="3.5" y="3.5" width="17" height="17" rx="3" />
                <path d="M8.25 10.5v6M8.25 7.6v.1M11.75 16.5v-6M11.75 13.25c0-1.6 1-2.75 2.4-2.75s2.1 1 2.1 2.6v3.4" />
              </svg>
            </a>
          </li>
        )
      }
    </ul>
  </div>

  <div class="conteneur pied__bas">
    <ul>
      <li><a href="/professionnels">Professionnels</a></li>
      <li><a href="/mentions-legales">Mentions légales</a></li>
      <li><a href="/politique-de-confidentialite">Politique de confidentialité</a></li>
      <li><a href="/cgv">CGV</a></li>
      {analytics && <li><button type="button" class="pied__cookies" data-gerer-cookies>Gérer les cookies</button></li>}
    </ul>
  </div>
</footer>

<style>
  /* Pied de page fin : une ligne (logo, menu, contact) puis une ligne de mentions. */
  .pied {
    padding-block: 1rem 0.75rem;
    font-size: var(--t-xs);
    letter-spacing: 0.06em;
  }
  .pied a {
    text-decoration: none;
  }
  .pied a:hover {
    text-decoration: underline;
    text-decoration-color: var(--ocre);
  }
  .pied ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem 1.5rem;
  }
  .pied__haut {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1.25rem 2.5rem;
  }
  .pied__marque :global(.pied__logo) {
    width: 3.5rem;
  }
  /* Contacts : même typo que le menu du haut (capitales espacées). */
  .pied__contact {
    align-items: center;
    text-transform: uppercase;
    letter-spacing: 0.18em;
  }
  /* Instagram et LinkedIn : pictos au trait fin. */
  .pied__reseau {
    display: inline-flex;
  }
  .pied__reseau svg {
    width: 1.15rem;
    height: 1.15rem;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.2;
    stroke-linecap: round;
    stroke-linejoin: round;
    transition: stroke 0.25s;
  }
  .pied__reseau .plein {
    fill: currentColor;
    stroke: none;
  }
  .pied__reseau:hover {
    color: var(--ocre);
  }
  .pied__bas {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 0.5rem 2rem;
    margin-top: 0.75rem;
    padding-top: 0.6rem;
    border-top: 1px solid color-mix(in srgb, var(--creme) 25%, transparent);
    opacity: 0.85;
  }
  .pied__cookies {
    background: none;
    border: 0;
    padding: 0;
    color: inherit;
    font: inherit;
    letter-spacing: inherit;
    cursor: pointer;
  }
  .pied__cookies:hover {
    text-decoration: underline;
  }
</style>
