---
import Logo from './Logo.astro'
import type {Reglages} from '../lib/types'

interface Props {
  reglages: Reglages
  analytics: boolean
}
const {reglages: r, analytics} = Astro.props
const tel = r.telephone?.replace(/\s/g, '')
---

<footer class="pied fond-ardoise">
  <div class="conteneur pied__ligne">
    <a href="/" class="pied__marque" aria-label="Studio Jeanne, retour à l’accueil"><Logo clair class="pied__logo" /></a>

    <ul class="pied__contact">
      {tel && <li><a href={`tel:${tel}`}>{r.telephone}</a></li>}
      {r.email && <li><a href={`mailto:${r.email}`}>{r.email}</a></li>}
      {
        (r.instagram || r.linkedin) && (
          <li class="pied__reseaux">
            {r.instagram && (
              <a class="pied__reseau" href={r.instagram} target="_blank" rel="noopener" aria-label="Instagram (nouvel onglet)">
                <svg viewBox="0 0 24 24" aria-hidden="true">
                  <rect x="3.5" y="3.5" width="17" height="17" rx="5" />
                  <circle cx="12" cy="12" r="4" />
                  <circle cx="17.2" cy="6.8" r="0.6" class="plein" />
                </svg>
              </a>
            )}
            {r.linkedin && (
              <a class="pied__reseau" href={r.linkedin} target="_blank" rel="noopener" aria-label="LinkedIn (nouvel onglet)">
                <svg viewBox="0 0 24 24" aria-hidden="true">
                  <rect x="3.5" y="3.5" width="17" height="17" rx="3" />
                  <path d="M8.25 10.5v6M8.25 7.6v.1M11.75 16.5v-6M11.75 13.25c0-1.6 1-2.75 2.4-2.75s2.1 1 2.1 2.6v3.4" />
                </svg>
              </a>
            )}
          </li>
        )
      }
    </ul>

    <ul class="pied__legal">
      <li><a href="/mentions-legales">Mentions légales</a></li>
      <li><a href="/politique-de-confidentialite">Politique de confidentialité</a></li>
      <li><a href="/cgv">CGV</a></li>
      {analytics && <li><button type="button" class="pied__cookies" data-gerer-cookies>Gérer les cookies</button></li>}
    </ul>
  </div>
</footer>

<style>
  /* Pied de page sur une seule ligne : logo à gauche, contact, puis mentions obligatoires à droite. */
  .pied {
    padding-block: 1.5rem;
    font-size: var(--t-xs);
    letter-spacing: 0.06em;
  }
  .pied a {
    text-decoration: none;
  }
  /* Écrans tactiles : liens un peu plus hauts au toucher, sans changer la mise en page. */
  @media (pointer: coarse) {
    .pied__contact a:not(.pied__reseau),
    .pied__legal a {
      padding-block: 0.25rem;
    }
  }
  .pied a:hover {
    text-decoration: underline;
    text-decoration-color: var(--ocre);
  }
  .pied ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem 1.5rem;
  }
  .pied__ligne {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1.25rem clamp(2rem, 6vw, 5rem);
  }
  .pied__marque :global(.pied__logo) {
    width: 8rem;
  }
  /* Mentions obligatoires : poussées complètement à droite. */
  .pied .pied__legal {
    margin-left: auto;
    opacity: 0.85;
  }
  /* Contacts : même typo que le menu du haut (capitales espacées). */
  .pied__contact {
    align-items: center;
    text-transform: uppercase;
    letter-spacing: 0.18em;
  }
  /* Instagram et LinkedIn : pictos au trait fin. */
  /* Zone de toucher de 34 px autour du picto (marge négative : rien ne bouge à l'écran). */
  .pied__reseau {
    display: inline-flex;
    padding: 0.5rem;
    margin: -0.5rem;
  }
  .pied__reseau svg {
    width: 1.15rem;
    height: 1.15rem;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.2;
    stroke-linecap: round;
    stroke-linejoin: round;
    transition: stroke 0.25s;
  }
  /* Instagram et LinkedIn toujours côte à côte, même écart que les autres contacts. */
  .pied__reseaux {
    display: flex;
    align-items: center;
    gap: 1.5rem;
  }
  /* Téléphone : les deux pictos ensemble sur leur propre ligne, sous l'adresse e-mail. */
  @media (max-width: 51.99rem) {
    .pied__reseaux {
      flex-basis: 100%;
      padding-top: 0.4rem;
    }
  }
  .pied__reseau .plein {
    fill: currentColor;
    stroke: none;
  }
  .pied__reseau:hover {
    color: var(--ocre);
  }
  .pied__cookies {
    background: none;
    border: 0;
    padding: 0;
    color: inherit;
    font: inherit;
    letter-spacing: inherit;
    cursor: pointer;
  }
  /* Même soulignement ocre au survol que les liens voisins. */
  .pied__cookies:hover {
    text-decoration: underline;
    text-decoration-color: var(--ocre);
    text-decoration-thickness: 1px;
    text-underline-offset: 0.2em;
  }
</style>
