---
import Base from '../layouts/Base.astro'
import SectionTexte from '../components/sections/SectionTexte.astro'
import {getPageContact, getReglages} from '../lib/contenu'

const [page, r] = await Promise.all([getPageContact(), getReglages()])
const titre = page.seo?.metaTitle || `Contact${r.suffixeTitre}`
const tel = r.telephone?.replace(/\s/g, '')

/** https://tally.so/r/abc123 → https://tally.so/embed/abc123 */
const idTally = r.lienTally?.match(/tally\.so\/(?:r|embed)\/([\w-]+)/)?.[1]
const embedTally = idTally
  ? `https://tally.so/embed/${idTally}?alignLeft=1&hideTitle=1&transparentBackground=1&dynamicHeight=1`
  : null
---

<Base titre={titre} description={page.seo?.metaDescription} imagePartage={page.seo?.imagePartage}>
  <!-- 1. Texte -->
  <SectionTexte titre={page.intro?.titre} niveau="h1" texte={page.intro?.texte} />

  <!-- 2. Formulaire Tally (bifurcation, budget, origine ; redirection Calendly gérée dans Tally) -->
  <section class="section section--serree fond-soutenu" id="formulaire">
    <div class="colonne">
      {
        embedTally ? (
          <>
            <iframe
              data-tally-src={embedTally}
              loading="lazy"
              width="100%"
              height="800"
              title="Formulaire de premier contact"
              class="tally"
            />
            <noscript>
              <a class="bouton" href={r.lienTally}>
                {page.boutonLibelle || 'Remplir le formulaire'}
              </a>
            </noscript>
            <script is:inline async src="https://tally.so/widgets/embed.js" />
          </>
        ) : (
          <p class="tally-manquant">Le formulaire s’affichera ici dès que son lien sera renseigné dans les réglages du site.</p>
        )
      }
    </div>
  </section>

  <!-- 3. Coordonnées -->
  <section class="section section--serree">
    <div class="colonne coordonnees">
      <p>
        {page.coordonnees}
        {' '}
        {tel && <a href={`tel:${tel}`}>{r.telephone}</a>}
        {tel && r.email && ' · '}
        {r.email && <a href={`mailto:${r.email}`}>{r.email}</a>}
      </p>
      {r.afficherAdresse && r.adresse && <p>{r.adresse}, {r.codePostal} {r.ville}</p>}
    </div>
  </section>

  <!-- 4. Zone d'intervention -->
  <SectionTexte titre={page.zone?.titre} texte={page.zone?.texte} fond="soutenu" />
</Base>

<style>
  .tally {
    border: 0;
    min-height: 30rem;
  }
  .tally-manquant {
    text-align: center;
    font-style: italic;
  }
  .coordonnees {
    font-size: var(--t-l);
    line-height: 1.5;
    color: var(--ardoise);
  }
</style>
