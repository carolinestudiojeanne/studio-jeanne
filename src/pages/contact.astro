---
import Base from '../layouts/Base.astro'
import SectionTexte from '../components/sections/SectionTexte.astro'
import IntroPage from '../components/sections/IntroPage.astro'
import Aiguillage from '../components/sections/Aiguillage.astro'
import Faq from '../components/sections/Faq.astro'
import {schemaFaq} from '../lib/seo'
import {getPageAccueil, getPageContact, getReglages} from '../lib/contenu'
import {FORMULAIRES} from '../lib/formulaires'

const [page, accueil, r] = await Promise.all([getPageContact(), getPageAccueil(), getReglages()])
const titre = page.seo?.metaTitle || `Contact${r.suffixeTitre}`
const tel = r.telephone?.replace(/\s/g, '')
---

<Base titre={titre} description={page.seo?.metaDescription} imagePartage={page.seo?.imagePartage} schemas={[schemaFaq(page.faq)]}>
  <!-- 1. Texte -->
  <IntroPage titre={page.intro?.titre} texte={page.intro?.texte} espaceBas={false} />

  <!-- 2. Trois portes d'entrée, chacune vers son formulaire Tally (qui redirige ensuite vers l'agenda) :
       les deux grandes, mêmes formulations que sur l'accueil, puis les professionnels, un cran en dessous. -->
  <section class="section section--serree" id="formulaire">
    <div class="conteneur">
      {accueil.aiguillage && <Aiguillage aiguillage={accueil.aiguillage} />}
      <div class="contact-pro">
        <p>Vous êtes un professionnel ?</p>
        <a class="bouton bouton--contour" href={FORMULAIRES.professionnel}>Parlons de vos locaux</a>
      </div>
    </div>
  </section>

  <!-- 3. Coordonnées -->
  <section class="section section--serree">
    <div class="colonne coordonnees">
      <p>
        {page.coordonnees}
        {' '}
        {tel && <a href={`tel:${tel}`}>{r.telephone}</a>}
        {tel && r.email && ' · '}
        {r.email && <a href={`mailto:${r.email}`}>{r.email}</a>}
      </p>
      {r.afficherAdresse && r.adresse && <p>{r.adresse}, {r.codePostal} {r.ville}</p>}
    </div>
  </section>

  <!-- 4. Zone d'intervention -->
  <SectionTexte titre={page.zone?.titre} texte={page.zone?.texte} fond="soutenu" />

  <!-- 5. Questions fréquentes (uniquement sur cette page) -->
  <Faq faq={page.faq} soutenu={false} />
</Base>

<style>
  .contact-pro {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    align-items: center;
    gap: 1rem 1.75rem;
    margin-top: clamp(2rem, 4vw, 3rem);
    padding: clamp(1.5rem, 3vw, 2rem);
    border: 1px solid color-mix(in srgb, var(--ardoise) 22%, transparent);
    border-radius: var(--arrondi);
    text-align: center;
  }
  .contact-pro p {
    margin: 0;
    font-size: var(--t-m);
  }
  .coordonnees {
    font-size: var(--t-l);
    line-height: 1.5;
    color: var(--ardoise);
  }
</style>
