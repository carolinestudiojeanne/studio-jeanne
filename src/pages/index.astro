---
import Base from '../layouts/Base.astro'
import Hero from '../components/sections/Hero.astro'
import ArchesContact from '../components/sections/ArchesContact.astro'
import CarrouselProjets from '../components/sections/CarrouselProjets.astro'
import MurAvis from '../components/sections/MurAvis.astro'
import Bande from '../components/sections/Bande.astro'
import {getAvisAccueil, getPageAccueil, getProjets, getReglages} from '../lib/contenu'
import {FORMULAIRES} from '../lib/formulaires'

const [page, tousProjets, avis, reglages] = await Promise.all([getPageAccueil(), getProjets(), getAvisAccueil(), getReglages()])
// L'accueil ne montre que les projets de particuliers (diaporama et projets récents).
const projets = tousProjets.filter((p) => p.categorie === 'residentiel')
const titre = page.seo?.metaTitle || `Architecte d’intérieur à Bordeaux${reglages.suffixeTitre}`
const {hero, projetsRecents, aiguillage} = page
---

<Base titre={titre} description={page.seo?.metaDescription} imagePartage={page.seo?.imagePartage || hero?.image}>
  <!-- 1. Grand visuel -->
  <Hero
    image={hero?.image}
    images={projets.map((p) => p.imagePrincipale).filter((i) => i !== undefined)}
    surtitre={hero?.h1}
    surtitreEstH1
    titre={hero?.accroche}
    sousTitre={hero?.sousTitre}
    centre
    bouton={{libelle: hero?.boutonLibelle, href: '/contact'}}
  />

  <!-- 2. Projets récents -->
  {
    projets.length > 0 && (
      <section class="section section-projets-recents">
        <CarrouselProjets projets={projets}>
          <div class="projets-recents">
            <h2>{projetsRecents?.titre}</h2>
            {projetsRecents?.texte && <p>{projetsRecents.texte}</p>}
          </div>
          {projetsRecents?.lienLibelle && (
            <p class="voir-projets" slot="lien">
              <a class="lien-fleche lien-chevron" href="/projets">
                {projetsRecents.lienLibelle}
              </a>
            </p>
          )}
        </CarrouselProjets>
      </section>
    )
  }

  <!-- 4. Deux points de départ, en arches basses comme sur la page Contact (sans l'arche pro), avec les liens vers les pages.
       Ancienne version (deux colonnes avec photos) : <ArchesContact aiguillage={aiguillage} sansPro liens />. -->
  {
    aiguillage && (
      <section class="section section-portes">
        <div class="conteneur">
          <h2 class="visuellement-cache">{aiguillage.titre || 'Deux points de départ'}</h2>
          <ArchesContact aiguillage={aiguillage} sansPro liens />
        </div>
      </section>
    )
  }

  <!-- 6. Les avis -->
  {
    avis.length > 0 && (
      <section class="section">
        <div class="conteneur">
          <div class="entete-section">
            <div>
              <h2>{page.avis?.titre}</h2>
            </div>
            <a class="lien-fleche lien-chevron" href="/avis-clients">
              {page.avis?.lienLibelle || 'Lire tous les avis'}
            </a>
          </div>
          <MurAvis avis={avis} egales />
        </div>
      </section>
    )
  }

  <!-- 7. La première étape : bande beige minimaliste, comme en bas de L'accompagnement -->
  {page.appel?.titre && <Bande texte={page.appel.titre} lien={page.appel.boutonLibelle || 'Remplir le formulaire'} href={FORMULAIRES.projet} description={page.appel.texte} deuxPoints descriptionUneLigne />}
</Base>

<style>
  .entete-section {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: flex-end;
    gap: 1.5rem 3rem;
    margin-bottom: clamp(2.5rem, 5vw, 4rem);
  }
  .entete-section h2 {
    margin-bottom: 0.5rem;
  }
  .entete-section p {
    max-width: 36rem;
  }
  /* Titre et phrase alignés sur la photo la plus à gauche ; phrase sur une seule ligne sur grand écran. */
  /* Titre et phrase bien aérés, avec un peu plus d'espace au-dessus (depuis le grand visuel) qu'en dessous (jusqu'aux photos). */
  .section-projets-recents {
    --air: clamp(3rem, 5.5vw, 5rem);
    /* Un peu plus d'espace entre le grand visuel et le titre. */
    padding-top: calc(var(--air) * 1.4);
    /* Un peu moins d'espace avant les arches. */
    padding-bottom: calc(var(--section) * 0.7);
  }
  .projets-recents {
    margin-bottom: var(--air);
  }
  /* Même taille que les titres des autres pages (bloc d'introduction). */
  .projets-recents h2 {
    font-size: clamp(1.3rem, 1rem + 0.8vw, 1.7rem);
    margin-bottom: 0.75rem;
  }
  .projets-recents p {
    margin: 0;
  }
  @media (min-width: 80rem) {
    .projets-recents p {
      white-space: nowrap;
      /* La taille suit la largeur d'écran pour que la phrase tienne sur une ligne. */
      font-size: min(var(--t-m), calc((100vw - 10rem) / 84));
    }
  }
  /* Juste au-dessus des photos, à droite, en ocre, sans trait ni flèche. */
  .voir-projets {
    margin: 1.5rem 0 0.75rem;
    text-align: right;
  }
  .voir-projets .lien-fleche {
    font-size: 0.75rem;
  }
  .voir-projets .lien-fleche::after {
    content: none;
  }
  /* Les deux portes d'entrée, sur fond blanc, sans titre visible. */
  .section-portes {
    background: var(--blanc);
    padding-top: calc(var(--section) * 0.7);
  }
  /* Les deux arches plus espacées, sans agrandir la section : l'espace pris au-dessus de la première arche passe entre les deux. */
  .section-portes :global(.arches) {
    margin-top: 0;
    gap: calc(clamp(3.5rem, 7vw, 5rem) + clamp(1.5rem, 3vw, 2.5rem));
  }
</style>
