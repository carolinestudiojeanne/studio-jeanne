---
import Base from '../layouts/Base.astro'
import Image from '../components/Image.astro'
import AppelAction from '../components/sections/AppelAction.astro'
import {getPageAPropos, getReglages} from '../lib/contenu'
import {texteEnHtml} from '../lib/texte'
import {SITE} from '../lib/seo'

const [page, reglages] = await Promise.all([getPageAPropos(), getReglages()])
// Titres fixés dans le code (demande de Caroline, octobre 2026) : le surtitre est le titre principal (H1),
// la phrase en grand dessous n'est pas un titre. Le champ « Titre » du Studio n'est plus affiché.
const SURTITRE = 'Caroline Canova, décoratrice et architecte d’intérieur à Bordeaux'
const SOUS_TITRE = 'Studio Jeanne, c’est une histoire bordelaise.'
// Image entièrement blanche posée en attendant le shooting : on ne l'affiche pas.
// Dès qu'une vraie photo la remplace dans le Studio, le second portrait réapparaît.
const PORTRAITS_VIDES = ['image-4551f710005d2703a7d33cfe4375f6e7989b3188-601x977-jpg']
const portrait2 = page.portrait2?.asset && PORTRAITS_VIDES.includes(page.portrait2.asset._ref) ? undefined : page.portrait2
const titre = page.seo?.metaTitle || `À propos${reglages.suffixeTitre}`
const personne = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  '@id': `${SITE}/a-propos#caroline`,
  name: 'Caroline Canova',
  jobTitle: 'Décoratrice d’intérieur',
  worksFor: [
    {'@id': `${SITE}/#entreprise`},
    {'@type': 'RealEstateAgent', name: 'Homelike Home', url: reglages.homelikehome},
  ],
  sameAs: [reglages.linkedin, reglages.instagram].filter(Boolean),
}
---

<Base titre={titre} description={page.seo?.metaDescription} imagePartage={page.seo?.imagePartage || page.portrait} schemas={[personne]}>
  <section class="section">
    <div class="conteneur apropos">
      <div class:list={['apropos__photos', {'apropos__photos--deux': page.portrait && portrait2}]}>
        <Image class="apropos__photo apropos__photo--1" image={page.portrait} ratio={4 / 5} legende={false} prioritaire sizes="(min-width: 52rem) 28vw, 70vw" />
        <Image class="apropos__photo apropos__photo--2" image={portrait2} ratio={4 / 5} legende={false} sizes="(min-width: 52rem) 24vw, 60vw" />
      </div>
      <div class="apropos__texte">
        <h1 class="surtitre apropos__surtitre">{SURTITRE}</h1>
        <p class="apropos__titre">{SOUS_TITRE}</p>
        <div class="texte" set:html={texteEnHtml(page.texte)} />
        {
          page.lienAvisLibelle && (
            <p class="apropos__avis">
              <a class="lien-fleche lien-chevron" href="/avis-clients">
                {page.lienAvisLibelle}
              </a>
            </p>
          )
        }
      </div>
    </div>
    {
      page.imageEchoppe && (
        <div class="conteneur apropos__echoppe">
          <Image image={page.imageEchoppe} sizes="(min-width: 82rem) 82rem, 100vw" />
        </div>
      )
    }
  </section>

  <AppelAction appel={page.appel} />
</Base>

<style>
  .apropos {
    display: grid;
    gap: 3rem;
  }
  @media (min-width: 52rem) {
    .apropos {
      grid-template-columns: 1fr 1.3fr;
      gap: clamp(3rem, 8vw, 8rem);
      align-items: start;
    }
    .apropos__photos {
      position: sticky;
      top: 7rem;
    }
    /* Sur ordinateur, la seconde photo déborde un peu plus vers la droite ; la première ne bouge pas. */
    .apropos__photos--deux :global(.apropos__photo--2) {
      transform: translateX(20%);
    }
  }
  /* Deux portraits décalés en diagonale : le premier en haut à gauche, le second plus bas à droite, qui le chevauche un peu. */
  .apropos__photos {
    max-width: 30rem;
  }
  .apropos__photos--deux {
    display: grid;
    grid-template-columns: repeat(10, 1fr);
  }
  .apropos__photos--deux :global(.apropos__photo--1) {
    grid-area: 1 / 1 / 2 / 8;
  }
  .apropos__photos--deux :global(.apropos__photo--2) {
    grid-area: 1 / 5 / 2 / 11;
    margin-top: 55%;
    position: relative;
  }
  /* Liseré couleur de fond pour détacher la seconde photo de la première. */
  .apropos__photos--deux :global(.apropos__photo--2 .image__cadre) {
    box-shadow: 0 0 0 0.5rem var(--creme);
  }
  .apropos__texte {
    max-width: var(--etroit);
  }
  /* Surtitre : lettrage du menu, en petit, juste au-dessus du titre. */
  .apropos__surtitre {
    line-height: 1.6;
    margin-bottom: 0.75rem;
  }
  /* Même lettrage que les titres de page, un peu plus grand. */
  /* Les retours à la ligne saisis dans le Studio sont respectés. */
  .apropos__titre {
    font-family: var(--police);
    color: var(--titres);
    text-transform: uppercase;
    letter-spacing: 0.18em;
    line-height: 1.4;
    margin: 0 0 0.75em;
    text-wrap: balance;
    font-size: clamp(1.3rem, 1rem + 0.8vw, 1.7rem);
    white-space: pre-line;
  }
  .apropos__avis {
    margin-top: 2.5rem;
  }
  .apropos__echoppe {
    margin-top: var(--section);
  }
</style>
