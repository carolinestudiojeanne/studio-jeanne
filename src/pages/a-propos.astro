---
import Base from '../layouts/Base.astro'
import Image from '../components/Image.astro'
import AppelAction from '../components/sections/AppelAction.astro'
import {getPageAPropos, getReglages} from '../lib/contenu'
import {texteEnHtml} from '../lib/texte'
import {SITE} from '../lib/seo'

const [page, reglages] = await Promise.all([getPageAPropos(), getReglages()])
const titre = page.seo?.metaTitle || `À propos${reglages.suffixeTitre}`
const personne = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  '@id': `${SITE}/a-propos#caroline`,
  name: 'Caroline Canova',
  jobTitle: 'Architecte et décoratrice d’intérieur',
  worksFor: [
    {'@id': `${SITE}/#entreprise`},
    {'@type': 'RealEstateAgent', name: 'Homelike Home', url: reglages.homelikehome},
  ],
  sameAs: [reglages.linkedin, reglages.instagram].filter(Boolean),
}
---

<Base titre={titre} description={page.seo?.metaDescription} imagePartage={page.seo?.imagePartage || page.portrait} schemas={[personne]}>
  <section class="section">
    <div class="conteneur apropos">
      <div class:list={['apropos__photos', {'apropos__photos--deux': page.portrait && page.portrait2}]}>
        <Image class="apropos__photo apropos__photo--1" image={page.portrait} ratio={4 / 5} legende={false} prioritaire sizes="(min-width: 52rem) 28vw, 70vw" />
        <Image class="apropos__photo apropos__photo--2" image={page.portrait2} ratio={4 / 5} legende={false} sizes="(min-width: 52rem) 24vw, 60vw" />
      </div>
      <div class="apropos__texte">
        <h1>{page.titre}</h1>
        <div class="texte" set:html={texteEnHtml(page.texte)} />
        {
          page.lienAvisLibelle && (
            <p class="apropos__avis">
              <a class="lien-fleche" href="/avis-clients">
                {page.lienAvisLibelle}
              </a>
            </p>
          )
        }
      </div>
    </div>
    {
      page.imageEchoppe && (
        <div class="conteneur apropos__echoppe">
          <Image image={page.imageEchoppe} sizes="(min-width: 82rem) 82rem, 100vw" />
        </div>
      )
    }
  </section>

  <AppelAction appel={page.appel} />
</Base>

<style>
  .apropos {
    display: grid;
    gap: 3rem;
  }
  @media (min-width: 52rem) {
    .apropos {
      grid-template-columns: 1fr 1.3fr;
      gap: clamp(3rem, 8vw, 8rem);
      align-items: start;
    }
    .apropos__photos {
      position: sticky;
      top: 7rem;
    }
  }
  /* Deux portraits décalés en diagonale : le premier en haut à gauche, le second plus bas à droite, qui le chevauche un peu. */
  .apropos__photos {
    max-width: 30rem;
  }
  .apropos__photos--deux {
    display: grid;
    grid-template-columns: repeat(10, 1fr);
  }
  .apropos__photos--deux :global(.apropos__photo--1) {
    grid-area: 1 / 1 / 2 / 8;
  }
  .apropos__photos--deux :global(.apropos__photo--2) {
    grid-area: 1 / 5 / 2 / 11;
    margin-top: 55%;
    position: relative;
  }
  /* Liseré couleur de fond pour détacher la seconde photo de la première. */
  .apropos__photos--deux :global(.apropos__photo--2 .image__cadre) {
    box-shadow: 0 0 0 0.5rem var(--creme);
  }
  .apropos__texte {
    max-width: var(--etroit);
  }
  /* Même taille de titre que l'en-tête des autres pages. */
  .apropos__texte h1 {
    font-size: clamp(1.3rem, 1rem + 0.8vw, 1.7rem);
  }
  .apropos__avis {
    margin-top: 2.5rem;
  }
  .apropos__echoppe {
    margin-top: var(--section);
  }
</style>
