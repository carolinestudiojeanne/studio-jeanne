---
import Base from '../layouts/Base.astro'
import MurAvis from '../components/sections/MurAvis.astro'
import IntroPage from '../components/sections/IntroPage.astro'
import AppelAction from '../components/sections/AppelAction.astro'
import {getAvis, getPageAvisClients, getReglages} from '../lib/contenu'

const [page, avis, r] = await Promise.all([getPageAvisClients(), getAvis(), getReglages()])
const titre = page.seo?.metaTitle || `Avis clients${r.suffixeTitre}`
---

<Base titre={titre} description={page.seo?.metaDescription} imagePartage={page.seo?.imagePartage}>
  <!-- En-tête, même format que les autres pages -->
  <IntroPage titre={page.intro?.titre || 'Avis clients'} texte={page.intro?.texte} espaceBas={false}>
    <p class="liens">
        {r.ficheGoogle && <a class="lien-fleche" href={r.ficheGoogle} target="_blank" rel="noopener">Tous les avis sur Google</a>}
        {r.lienLaisserAvis && <a class="lien-fleche" href={r.lienLaisserAvis} target="_blank" rel="noopener">Laisser un avis</a>}
    </p>
  </IntroPage>

  <section class="section section--serree mur-section">
    <div class="conteneur">
      <MurAvis avis={avis} />
    </div>
  </section>

  <AppelAction appel={page.appel} />
</Base>

<style>
  /* Le mur d'avis suit de près le lien « Tous les avis sur Google ». */
  .mur-section {
    padding-top: clamp(2.5rem, 5vw, 3.5rem);
  }
  /* Liens sans soulignement */
  .liens .lien-fleche {
    border-bottom: 0;
  }
  .liens {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 1rem 2rem;
    margin: 1rem 0 0;
  }
</style>
