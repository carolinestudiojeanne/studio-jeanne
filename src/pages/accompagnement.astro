---
import PageOffre from '../components/PageOffre.astro'
import DerouleArche from '../components/sections/DerouleArche.astro'
import {FORMULAIRES} from '../lib/formulaires'
import {getPageAccompagnement, getReglages} from '../lib/contenu'

const [page, reglages] = await Promise.all([getPageAccompagnement(), getReglages()])
---

<PageOffre page={page} titre={page.seo?.metaTitle || `L’accompagnement${reglages.suffixeTitre}`} aiguillageHref="/trouver-votre-bien" formulaire={FORMULAIRES.projet} sansTemps>
  <DerouleArche slot="apres-intro" />
</PageOffre>
