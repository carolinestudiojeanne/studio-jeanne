---
import Base from '../../layouts/Base.astro'
import GrilleProjets from '../../components/sections/GrilleProjets.astro'
import Image from '../../components/Image.astro'
import {getPageProjets, getProjets, getReglages} from '../../lib/contenu'
import {texteEnHtml} from '../../lib/texte'

const [page, projets, reglages] = await Promise.all([getPageProjets(), getProjets(), getReglages()])
const titre = page.seo?.metaTitle || `Projets${reglages.suffixeTitre}`
const introHtml = texteEnHtml(page.intro?.texte)
---

<Base titre={titre} description={page.seo?.metaDescription} imagePartage={page.seo?.imagePartage}>
  <!-- 1. Introduction -->
  <section class="section section--serree intro-projets">
    <div class="conteneur">
      <h1>{page.intro?.titre || 'Projets'}</h1>
      {introHtml && <div class="texte intro-projets__texte" set:html={introHtml} />}
    </div>
  </section>

  <!-- 2. Filtres (particuliers par défaut) puis grille des projets, dans l'ordre choisi par Caroline -->
  <section class="conteneur grille-projets" data-filtre="residentiel">
    <h2 class="visuellement-cache">Tous les projets</h2>
    <div class="filtres" role="group" aria-label="Type de projets">
      <button type="button" class="filtre" data-categorie="residentiel" aria-pressed="true">Particuliers</button>
      <button type="button" class="filtre" data-categorie="professionnel" aria-pressed="false">Professionnels</button>
    </div>
    <GrilleProjets projets={projets} colonnes={4} />
  </section>

  <!-- 3. Bloc Professionnels, avec image -->
  {
    page.blocPro?.titre && (
      <section class="section">
        <div class="conteneur">
          <a class="bloc-pro fond-ardoise" href="/professionnels">
            <Image image={page.blocPro.image} ratio={3 / 2} legende={false} sizes="(min-width: 52rem) 50vw, 100vw" />
            <div class="bloc-pro__texte">
              <span class="surtitre">Professionnels</span>
              <h2>{page.blocPro.titre}</h2>
              {page.blocPro.texte && <p>{page.blocPro.texte}</p>}
              {page.blocPro.lienLibelle && <span class="lien-fleche">{page.blocPro.lienLibelle}</span>}
            </div>
          </a>
        </div>
      </section>
    )
  }
</Base>

<script>
  // Filtres Particuliers / Professionnels : on arrive sur « Particuliers ».
  document.querySelectorAll<HTMLElement>('[data-filtre]').forEach((zone) => {
    zone.querySelectorAll<HTMLButtonElement>('.filtre').forEach((bouton) => {
      bouton.addEventListener('click', () => {
        zone.dataset.filtre = bouton.dataset.categorie
        zone.querySelectorAll('.filtre').forEach((b) => b.setAttribute('aria-pressed', String(b === bouton)))
      })
    })
  })
</script>

<style>
  /* Filtres : deux boutons arrondis au-dessus des projets, à droite. */
  .filtres {
    display: flex;
    justify-content: flex-end;
    gap: 0.75rem;
    margin-bottom: clamp(1.5rem, 3vw, 2rem);
  }
  .filtre {
    padding: 0.7em 1.6em;
    border-radius: 999px;
    border: 1px solid var(--ardoise);
    background: transparent;
    color: var(--ardoise);
    font: inherit;
    font-size: var(--t-xs);
    letter-spacing: 0.18em;
    text-transform: uppercase;
    cursor: pointer;
    transition: background 0.25s, color 0.25s;
  }
  .filtre:hover,
  .filtre[aria-pressed='true'] {
    background: var(--ardoise);
    color: var(--blanc);
  }
  [data-filtre='residentiel'] :global(.grille > li[data-categorie='professionnel']),
  [data-filtre='professionnel'] :global(.grille > li:not([data-categorie='professionnel'])) {
    display: none;
  }
  /* Introduction centrée ; sur grand écran, la phrase tient sur une seule ligne. */
  .intro-projets {
    text-align: center;
  }
  /* Titre sur une seule ligne, centré. */
  .intro-projets h1 {
    margin-inline: auto;
  }
  @media (min-width: 52rem) {
    .intro-projets h1 {
      white-space: nowrap;
    }
  }
  @media (min-width: 72rem) {
    .intro-projets__texte :global(p) {
      white-space: nowrap;
    }
  }
  .grille-projets {
    padding-bottom: var(--section);
  }
  .bloc-pro {
    display: grid;
    text-decoration: none;
    overflow: hidden;
  }
  @media (min-width: 52rem) {
    .bloc-pro {
      grid-template-columns: 1fr 1fr;
      align-items: center;
    }
  }
  .bloc-pro__texte {
    padding: clamp(2rem, 6vw, 5rem);
  }
  .bloc-pro__texte h2 {
    font-size: var(--t-l);
  }
  .bloc-pro__texte p {
    margin-bottom: 2rem;
  }
  .bloc-pro .lien-fleche {
    color: var(--creme);
  }
  .bloc-pro :global(img) {
    transition: transform 0.8s cubic-bezier(0.2, 0.7, 0.2, 1);
  }
  .bloc-pro:hover :global(img) {
    transform: scale(1.03);
  }
</style>
