---
import Base from '../../layouts/Base.astro'
import GrilleProjets from '../../components/sections/GrilleProjets.astro'
import IntroPage from '../../components/sections/IntroPage.astro'
import {getPageProjets, getProjets, getReglages} from '../../lib/contenu'

const [page, projets, reglages] = await Promise.all([getPageProjets(), getProjets(), getReglages()])
const titre = page.seo?.metaTitle || `Projets${reglages.suffixeTitre}`
---

<Base titre={titre} description={page.seo?.metaDescription} imagePartage={page.seo?.imagePartage}>
  <!-- 1. Introduction -->
  <IntroPage titre={page.intro?.titre || 'Projets'} texte={page.intro?.texte} />

  <!-- 2. Filtres (particuliers par défaut) puis grille des projets, dans l'ordre choisi par Caroline -->
  <section class="conteneur grille-projets" data-filtre="residentiel">
    <h2 class="visuellement-cache">Tous les projets</h2>
    <div class="filtres" role="group" aria-label="Type de projets">
      <button type="button" class="filtre" data-categorie="residentiel" aria-pressed="true">Particuliers</button>
      <button type="button" class="filtre" data-categorie="professionnel" aria-pressed="false">Professionnels</button>
    </div>
    <GrilleProjets projets={projets} colonnes={4} />
  </section>

  <!-- Ancienne bande « Commerces et restaurants » vers la page Professionnels : retirée (octobre 2026),
       les projets professionnels s'affichent avec le filtre ci-dessus. -->
</Base>

<script>
  // Filtres Particuliers / Professionnels : on arrive sur « Particuliers »,
  // ou sur « Professionnels » avec /projets?type=professionnels (ancienne page /professionnels, fil d'Ariane des projets pros).
  document.querySelectorAll<HTMLElement>('[data-filtre]').forEach((zone) => {
    const choisir = (bouton: HTMLButtonElement) => {
      zone.dataset.filtre = bouton.dataset.categorie
      zone.querySelectorAll('.filtre').forEach((b) => b.setAttribute('aria-pressed', String(b === bouton)))
    }
    zone.querySelectorAll<HTMLButtonElement>('.filtre').forEach((bouton) => bouton.addEventListener('click', () => choisir(bouton)))
    if (new URLSearchParams(location.search).get('type') === 'professionnels') {
      const pro = zone.querySelector<HTMLButtonElement>('.filtre[data-categorie="professionnel"]')
      if (pro) choisir(pro)
    }
  })
</script>

<style>
  /* Lieu des projets en ocre (essai). */
  .grille-projets :global(.carte__lieu) {
    color: var(--ocre);
  }

  /* Filtres : deux boutons arrondis ocre au-dessus des projets, à gauche. */
  /* Même écart entre les filtres et la 1re ligne de projets qu'entre deux lignes de projets. */
  .grille-projets {
    --ecart-lignes: clamp(1.75rem, 3vw, 2.5rem);
  }
  .filtres {
    display: flex;
    justify-content: flex-start;
    gap: 0.75rem;
    margin-bottom: var(--ecart-lignes);
  }
  .grille-projets :global(.grille) {
    row-gap: var(--ecart-lignes);
  }
  .filtre {
    padding: 0.7em 1.6em;
    border-radius: 999px;
    border: 1px solid var(--ocre);
    background: transparent;
    color: var(--ocre);
    font: inherit;
    font-size: var(--t-xs);
    letter-spacing: 0.18em;
    text-transform: uppercase;
    cursor: pointer;
    transition: background 0.25s, color 0.25s;
  }
  .filtre:hover,
  .filtre[aria-pressed='true'] {
    background: var(--ocre);
    color: var(--blanc);
  }
  [data-filtre='residentiel'] :global(.grille > li[data-categorie='professionnel']),
  [data-filtre='professionnel'] :global(.grille > li:not([data-categorie='professionnel'])) {
    display: none;
  }
  .grille-projets {
    padding-bottom: var(--section);
  }
</style>
