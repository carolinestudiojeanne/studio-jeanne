---
import PageOffre from '../components/PageOffre.astro'
import DerouleArche from '../components/sections/DerouleArche.astro'
import {getPageTrouverVotreBien, getReglages} from '../lib/contenu'
import {FORMULAIRES} from '../lib/formulaires'
import type {EtapeArche} from '../lib/types'

const [page, reglages] = await Promise.all([getPageTrouverVotreBien(), getReglages()])

// Étapes de secours, si Sanity est vide (même arche que L'accompagnement, étapes de la recherche).
const parDefaut: {etapes: EtapeArche[]; travaux: EtapeArche} = {
  etapes: [
    {titre: 'Cahier des charges', texte: 'Je l’établis avec vous : votre façon de vivre, votre budget, tous vos critères de recherche. C’est la base sur laquelle je sélectionne chaque bien.'},
    {titre: 'Recherche', texte: 'Annonces, réseau d’agents immobiliers partenaires de Homelike Home, ventes entre particuliers, bouche-à-oreille : je regarde partout pour ne passer à côté d’aucun bien.'},
    {titre: 'Pré-visites', texte: 'Je visite chaque bien avant vous, en voyant ce qu’il peut devenir, ou ce qui doit vous en détourner. Vous ne vous déplacez que pour ceux qui peuvent vraiment vous plaire.'},
    {titre: 'Vérifications', texte: 'Règlement de copropriété, diagnostics, contraintes techniques : j’examine chaque document avant que vous ne vous engagiez.'},
    {titre: 'De l’offre aux clés', texte: 'Je mène avec vous l’offre, la négociation et le compromis, puis je vous accompagne jusqu’à la signature chez le notaire et la remise des clés.'},
  ],
  travaux: {
    titre: 'Aménagement',
    texte:
      'Si vous le souhaitez, je poursuis l’accompagnement avec Studio Jeanne pour concevoir votre intérieur. Le projet ne repart pas de zéro, puisque j’y réfléchis avec vous depuis la première visite.',
  },
}
---

<PageOffre
  page={page}
  titre={page.seo?.metaTitle || `Trouver votre bien${reglages.suffixeTitre}`}
  aiguillageHref="/accompagnement"
  formulaire={FORMULAIRES.trouver}
  lienSortant={{libelle: page.lienHomelikeLibelle, href: reglages.homelikehome}}
  sansTemps
  finBande
  boutonFin="Parlons de votre recherche"
>
  <DerouleArche slot="apres-intro" deroule={page.deroule} parDefaut={parDefaut} surtitreApres="Et après" titreSection="Le déroulé de la recherche" />
</PageOffre>
