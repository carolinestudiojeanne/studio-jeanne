---
import Base from '../layouts/Base.astro'
import SectionTexte from '../components/sections/SectionTexte.astro'
import GrilleProjets from '../components/sections/GrilleProjets.astro'
import AppelAction from '../components/sections/AppelAction.astro'
import {getPageProfessionnels, getProjets, getReglages} from '../lib/contenu'
import {FORMULAIRES} from '../lib/formulaires'

const [page, projets, reglages] = await Promise.all([getPageProfessionnels(), getProjets(), getReglages()])
const pros = projets.filter((p) => p.categorie === 'professionnel')
const titre = page.seo?.metaTitle || `Professionnels${reglages.suffixeTitre}`
---

<Base titre={titre} description={page.seo?.metaDescription} imagePartage={page.seo?.imagePartage}>
  <SectionTexte titre={page.intro?.titre || 'Professionnels'} niveau="h1" texte={page.intro?.texte} serree />
  <section class="conteneur grille-projets">
    <h2 class="visuellement-cache">Projets professionnels</h2>
    <GrilleProjets projets={pros} />
  </section>
  <AppelAction appel={page.appel} href={FORMULAIRES.professionnel} />
</Base>

<style>
  .grille-projets {
    padding-bottom: var(--section);
  }
</style>
